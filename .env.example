# Proveedor de IA opcional para /api/project-assistant
# Sin estas claves, el asistente opera en Modo guiado local con reglas estructuradas.
# Configura exactamente una de las siguientes opciones si deseas activar asistencia con IA:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# O alternativamente Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Recepción comercial opcional para /api/project-submit (Resend)
# Sin RESEND_API_KEY, el resumen se puede descargar y abrir en el cliente de correo local.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@enix.studio
CONTACT_FROM_EMAIL=ENIX Studio <noreply@enix.studio>
