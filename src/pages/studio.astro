---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { siteConfig } from "@/content/site";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Estudio", path: "/studio/" }
  ])
];
---

<MarketingLayout
  title="Estudio — ENIX Studio"
  description="Cómo trabaja ENIX Studio, quién acompaña cada proyecto en diseño, desarrollo y marketing digital, y nuestra relación con NOVVOR."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="studio-hero-grid">
        <div class="studio-head">
          <div class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            <span>Sobre ENIX Studio</span>
          </div>
          <h1 class="heading-xl">Un estudio directo de diseño, ingeniería y marketing</h1>
          <p class="lead">
            Sin intermediarios ni cajas negras: las personas que definen el alcance contigo son las mismas que construyen tu proyecto.
          </p>
          <div class="studio-cta">
            <a href="/create-project/" class="btn btn-primary">Definir mi proyecto →</a>
            <a href="/contact/" class="btn btn-secondary">Hablar con el equipo</a>
          </div>
        </div>

        <aside class="studio-id-card">
          <span class="studio-id-kicker">Respaldo y operación</span>
          <div class="studio-id-row">
            <span>Unidad digital de</span>
            <strong>{siteConfig.legalParent}</strong>
          </div>
          <div class="studio-id-row">
            <span>Base</span>
            <strong>{siteConfig.location}</strong>
          </div>
          <div class="studio-id-row">
            <span>Dirección directa</span>
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </div>
          <div class="studio-id-pills">
            <span>Diseño</span>
            <span>Desarrollo</span>
            <span>Marketing</span>
            <span>IA aplicada</span>
          </div>
        </aside>
      </div>

      <div class="studio-grid">
        <article class="studio-card">
          <span class="studio-kicker">01 · Trato directo</span>
          <h2 class="heading-md">Un solo equipo, tres áreas</h2>
          <p>
            Núcleo compacto de producto, diseño e ingeniería, sumando especialistas en marketing o integraciones según tu alcance real.
          </p>
        </article>
        <article class="studio-card">
          <span class="studio-kicker">02 · Método visible</span>
          <h2 class="heading-md">Etapas claras y aprobables</h2>
          <p>
            Entender, diseñar, construir y acompañar con entregables concretos en cada hito para decidir sin sorpresas.
          </p>
        </article>
        <article class="studio-card is-warm">
          <span class="studio-kicker">03 · Base propia</span>
          <h2 class="heading-md">Control total de tus activos</h2>
          <p>
            Separamos pauta de honorarios y entregamos código, cuentas y documentación limpia para que siempre mantengas el control.
          </p>
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .studio-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: center;
    margin-block-end: 2.5rem;
  }

  .studio-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .studio-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 0.25rem;
  }

  .studio-id-card {
    padding: 1.5rem;
    border-radius: 24px;
    background: var(--surface-dark);
    color: var(--ink-on-dark);
    border: 1px solid var(--border-on-dark);
    box-shadow: 0 22px 46px -18px rgba(48, 27, 60, 0.36);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .studio-id-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--glow-peach);
  }

  .studio-id-row {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding-block-end: 0.65rem;
    border-bottom: 1px solid var(--border-on-dark);
  }

  .studio-id-row span {
    font-size: 0.7rem;
    color: var(--ink-on-dark-muted);
  }

  .studio-id-row strong,
  .studio-id-row a {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
  }

  .studio-id-row a {
    color: var(--glow-peach);
    text-decoration: underline;
  }

  .studio-id-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .studio-id-pills span {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffffff;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .studio-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .studio-card.is-warm {
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border-color: rgba(243, 75, 33, 0.2);
  }

  .studio-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  .studio-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 900px) {
    .studio-hero-grid,
    .studio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
