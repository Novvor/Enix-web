---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { siteConfig } from "@/content/site";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Estudio", path: "/studio/" }
  ])
];
---

<MarketingLayout
  title="Estudio — ENIX Studio"
  description="Cómo trabaja ENIX Studio, quién acompaña cada proyecto en diseño, desarrollo y marketing digital, y nuestra relación con NOVVOR."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="studio-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Sobre ENIX Studio</span>
        </div>
        <h1 class="heading-xl">Un estudio digital directo en diseño, desarrollo y marketing</h1>
        <p class="lead">
          ENIX Studio —parte de <strong>{siteConfig.legalParent}</strong>— ayuda a emprendedores y empresas a diseñar, construir y hacer crecer sus canales digitales desde {siteConfig.location}.
        </p>
      </div>

      <div class="studio-org-grid">
        <article class="studio-org-card">
          <span class="studio-kicker">Quién te acompaña</span>
          <h2 class="heading-md">Dirección de proyectos directa y especialistas según alcance</h2>
          <p>
            Cada proyecto cuenta con una interlocución responsable desde la evaluación inicial hasta la entrega. Trabajamos con un núcleo compacto de dirección de producto, diseño e ingeniería, sumando especialistas en marketing digital, contenido o integraciones según lo que tu proyecto necesite.
          </p>
          <p>
            No delegamos tu proyecto a una cadena de intermediarios ni a plantillas cerradas: las personas que definen el alcance contigo son las mismas que supervisan su construcción.
          </p>
        </article>

        <article class="studio-org-card is-warm">
          <span class="studio-kicker">Relación con {siteConfig.legalParent}</span>
          <h2 class="heading-md">Respaldo técnico y continuidad operativa</h2>
          <p>
            ENIX Studio opera como la unidad de diseño, desarrollo digital y marketing de <strong>{siteConfig.legalParent}</strong>. Esto nos permite abordar tanto sitios comerciales y campañas como sistemas internos, portales e integraciones con procesos críticos.
          </p>
          <p>
            Si necesitas conversar directamente con la dirección de proyectos, escríbenos a{" "}
            <a href={`mailto:${siteConfig.contactEmail}`} style="color: var(--accent-deep); font-weight: 700; text-decoration: underline;">
              {siteConfig.contactEmail}
            </a>.
          </p>
        </article>
      </div>

      <div class="studio-grid">
        <article class="studio-card">
          <h2 class="heading-md">Qué hacemos directamente</h2>
          <p>
            Sitios web comerciales, aplicaciones, sistemas de gestión, portales, automatizaciones, soluciones de IA aplicada, identidad de marca y marketing digital (estrategia, publicidad, SEO y analítica).
          </p>
        </article>
        <article class="studio-card">
          <h2 class="heading-md">Cómo nos organizamos</h2>
          <p>
            Trabajamos por etapas verificables —entender, diseñar, construir y acompañar— con entregables concretos en cada hito para que tomes decisiones con claridad antes de pasar a la siguiente fase.
          </p>
        </article>
        <article class="studio-card">
          <h2 class="heading-md">Compromisos realistas</h2>
          <p>
            Separamos siempre lo esencial de futuras etapas, distinguimos inversión publicitaria de honorarios de servicio y entregamos documentación clara para que tu equipo mantenga el control de sus cuentas y activos.
          </p>
        </article>
      </div>

      <div class="studio-cta">
        <a href="/create-project/" class="btn btn-primary">Definir mi proyecto →</a>
        <a href="/demos/" class="btn btn-secondary">Probar demostraciones</a>
        <a href="/contact/" class="btn btn-secondary">Escribir al equipo</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .studio-head {
    max-inline-size: 820px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-block-end: 2.5rem;
  }

  .studio-org-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-block-end: 1.5rem;
  }

  .studio-org-card {
    padding: clamp(1.5rem, 3vw, 2.15rem);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .studio-org-card.is-warm {
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border-color: rgba(243, 75, 33, 0.18);
  }

  .studio-kicker {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  .studio-org-card p,
  .studio-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.65;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .studio-card {
    padding: 1.65rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .studio-cta {
    margin-block-start: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 820px) {
    .studio-org-grid,
    .studio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
