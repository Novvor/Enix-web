---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { solutions } from "@/content/solutions";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Soluciones", path: "/solutions/" }
  ])
];
---

<MarketingLayout
  title="Soluciones digitales a medida — ENIX Studio"
  description="Sitios web, aplicaciones, sistemas de gestión, portales, automatizaciones y soluciones de IA diseñadas y desarrolladas a medida."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Capacidades ENIX Studio</span>
        </div>
        <h1 class="heading-xl">Soluciones digitales construidas alrededor de tu operación</h1>
        <p class="lead">
          Un proyecto puede combinar varias de estas piezas. Explora cada línea o empieza directamente describiendo tu necesidad en el asistente.
        </p>
        <div class="page-head-actions">
          <a href="/create-project/" class="btn btn-primary">Definir mi proyecto →</a>
          <a href="/demos/" class="btn btn-secondary">Ver demostraciones</a>
        </div>
      </div>

      <div class="solutions-catalog-grid">
        {solutions.map((item) => (
          <article class="catalog-card">
            <span class="catalog-eyebrow">{item.eyebrow}</span>
            <h2 class="heading-md">{item.name}</h2>
            <p class="catalog-desc">{item.intro}</p>
            <ul class="catalog-bullets">
              {item.canInclude.slice(0, 3).map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
            <div class="catalog-actions">
              <a href={`/solutions/${item.slug}/`} class="btn btn-secondary btn-sm">Ver detalle</a>
              <a href={`/create-project/?category=${item.slug}`} class="btn btn-primary btn-sm">
                Definir {item.name.toLowerCase()} →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .page-head {
    max-inline-size: 760px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-block-end: 3rem;
  }

  .page-head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .solutions-catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .catalog-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .catalog-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-deep);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .catalog-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.6;
  }

  .catalog-bullets {
    padding-inline-start: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--ink-primary);
  }

  .catalog-actions {
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  @media (max-width: 820px) {
    .solutions-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
