---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { solutions } from "@/content/solutions";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Soluciones", path: "/solutions/" }
  ])
];
---

<MarketingLayout
  title="Soluciones digitales a medida — ENIX Studio"
  description="Sitios web, aplicaciones, sistemas de gestión, portales, automatizaciones y soluciones de IA diseñadas y desarrolladas a medida."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Desarrollo a medida · ENIX Studio</span>
        </div>
        <h1 class="heading-xl">Soluciones digitales construidas alrededor de tu operación</h1>
        <p class="lead">
          Elige una línea o combínalas según lo que necesite tu negocio.
        </p>
        <div class="page-head-actions">
          <a href="/create-project/" class="btn btn-primary">Definir mi proyecto →</a>
          <a href="/demos/" class="btn btn-secondary">Probar demostraciones</a>
        </div>
      </div>

      <div class="solutions-catalog-grid">
        {solutions.map((item, idx) => (
          <article class="catalog-card">
            <div class="catalog-top">
              <span class="catalog-icon" aria-hidden="true">
                {item.previewType === "web" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                )}
                {item.previewType === "app" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                )}
                {item.previewType === "system" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                )}
                {item.previewType === "portal" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
                {item.previewType === "automation" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                )}
                {item.previewType === "ai" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.8h6.1l-4.9 3.6 1.9 5.8-5-3.6-5 3.6 1.9-5.8-4.9-3.6h6.1z"/></svg>
                )}
              </span>
              <span class="catalog-num">0{idx + 1}</span>
            </div>

            <h2 class="heading-md">{item.name}</h2>
            <p class="catalog-desc">{item.shortDescription}</p>

            <ul class="catalog-bullets">
              {item.canInclude.slice(0, 2).map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>

            <div class="catalog-actions">
              <a href={`/solutions/${item.slug}/`} class="catalog-detail-link">Ver detalle →</a>
              <a href={`/create-project/?category=${item.slug}`} class="btn btn-primary btn-sm">
                Definir
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .page-head {
    max-inline-size: 720px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-block-end: 2.25rem;
  }

  .page-head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 0.25rem;
  }

  .solutions-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .catalog-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.45rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .catalog-card:hover {
    border-color: rgba(243, 75, 33, 0.38);
  }

  .catalog-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .catalog-icon {
    inline-size: 42px;
    block-size: 42px;
    border-radius: 13px;
    background: linear-gradient(145deg, #fff1e8 0%, #f5ecf7 100%);
    border: 1px solid rgba(243, 75, 33, 0.18);
    color: var(--accent-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .catalog-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink-muted);
  }

  .catalog-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .catalog-bullets {
    padding-inline-start: 1.05rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-xs);
    color: var(--ink-primary);
    line-height: 1.45;
  }

  .catalog-actions {
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    border-top: 1px solid rgba(48, 27, 60, 0.07);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
  }

  .catalog-detail-link {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-deep);
  }

  .catalog-detail-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .solutions-catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .solutions-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
