---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { solutions, type SolutionItem } from "@/content/solutions";
import { siteConfig } from "@/content/site";
import { buildBreadcrumbSchema, buildServiceSchema } from "@/lib/seo/schema";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution }
  }));
}

interface Props {
  solution: SolutionItem;
}

const { solution } = Astro.props;
const others = solutions.filter((s) => s.slug !== solution.slug).slice(0, 3);
const demoMap: Record<string, { href: string; label: string }> = {
  websites: { href: "/demos/bookings/", label: "Probar demo de reservas →" },
  applications: { href: "/demos/bookings/", label: "Probar demo de reservas →" },
  "management-systems": { href: "/demos/order-management/", label: "Probar demo de operación →" },
  automations: { href: "/demos/automation/", label: "Probar demo de automatización →" }
};
const relatedDemo = demoMap[solution.slug];
const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Soluciones", path: "/solutions/" },
    { name: solution.name, path: `/solutions/${solution.slug}/` }
  ]),
  buildServiceSchema({
    name: `${solution.name} a medida`,
    description: solution.intro,
    path: `/solutions/${solution.slug}/`,
    serviceType: solution.name
  })
];
---

<MarketingLayout
  title={`${solution.name} a medida — ENIX Studio`}
  description={solution.intro}
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <nav aria-label="Ruta de navegación" class="breadcrumb">
        <a href="/">Portada</a> / <a href="/solutions/">Soluciones</a> / <span>{solution.name}</span>
      </nav>

      <!-- 2-column Hero: clear value left + tangible application preview right -->
      <div class="sol-hero-grid">
        <div class="sol-hero">
          <div class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            <span>{solution.eyebrow}</span>
          </div>
          <h1 class="heading-xl">{solution.headline}</h1>
          <p class="lead">{solution.intro}</p>
          <div class="sol-hero-actions">
            <a
              href={`/create-project/?category=${solution.slug}`}
              class="btn btn-primary"
              data-start-category={solution.slug}
              data-start-prompt={solution.starterPrompt}
            >
              Definir {solution.name.toLowerCase()} →
            </a>
            <a href="/contact/" class="btn btn-secondary">Hablar con el equipo</a>
          </div>
        </div>

        <aside class="sol-preview-dark">
          <span class="sol-dark-kicker">Ejemplo real de aplicación</span>
          <h2 class="sol-dark-title">{solution.exampleTitle}</h2>
          <p class="sol-dark-copy">{solution.exampleSummary}</p>
          <ul class="sol-dark-list">
            {solution.exampleHighlights.map((h) => (
              <li>✓ {h}</li>
            ))}
          </ul>
          {relatedDemo && (
            <a href={relatedDemo.href} class="btn btn-light btn-sm" style="align-self:flex-start; margin-top:0.25rem;">
              {relatedDemo.label}
            </a>
          )}
        </aside>
      </div>

      <!-- 3 concise scannable cards -->
      <div class="sol-detail-grid">
        <article class="sol-block">
          <span class="sol-kicker">Para quién</span>
          <h2 class="heading-md">Cuándo conviene</h2>
          <ul class="sol-list">
            {solution.forWhom.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>

        <article class="sol-block">
          <span class="sol-kicker">Qué resuelve</span>
          <h2 class="heading-md">El bloqueo que destrabamos</h2>
          <p class="sol-copy">{solution.problemSolved}</p>
        </article>

        <article class="sol-block">
          <span class="sol-kicker">Alcance modular</span>
          <h2 class="heading-md">Qué puede incluir</h2>
          <ul class="sol-list">
            {solution.canInclude.slice(0, 4).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      </div>

      <div class="sol-start-banner">
        <div>
          <h2 class="heading-md">¿Cómo empezar?</h2>
          <p class="sol-copy" style="margin-block-start: 0.3rem;">{solution.howToStart}</p>
          <p style="font-size: var(--text-xs); color: var(--ink-muted); margin-block-start: 0.4rem;">
            {siteConfig.responsibilityStatement}
          </p>
        </div>
        <a
          href={`/create-project/?category=${solution.slug}`}
          class="btn btn-primary"
          data-start-category={solution.slug}
          data-start-prompt={solution.starterPrompt}
        >
          Empezar ahora →
        </a>
      </div>

      <div class="related-block">
        <h2 class="heading-md" style="margin-block-end: 0.9rem;">También puedes combinarlo con</h2>
        <div class="related-grid">
          {others.map((o) => (
            <a href={`/solutions/${o.slug}/`} class="related-card">
              <strong>{o.name} →</strong>
              <span>{o.shortDescription}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .breadcrumb {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-block-end: 1.15rem;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    color: var(--ink-primary);
  }

  .sol-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: center;
    margin-block-end: 2.5rem;
  }

  .sol-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .sol-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 0.25rem;
  }

  .sol-preview-dark {
    padding: 1.5rem;
    border-radius: 24px;
    background: var(--surface-dark);
    color: var(--ink-on-dark);
    border: 1px solid var(--border-on-dark);
    box-shadow: 0 22px 46px -18px rgba(48, 27, 60, 0.36);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .sol-dark-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--glow-peach);
  }

  .sol-dark-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .sol-dark-copy {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-on-dark-muted);
    line-height: 1.55;
  }

  .sol-dark-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
  }

  .sol-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .sol-block {
    padding: 1.45rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sol-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  .sol-copy {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .sol-list {
    padding-inline-start: 1.1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--ink-primary);
    line-height: 1.5;
  }

  .sol-start-banner {
    margin-block-start: 1.75rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border: 1px solid rgba(243, 75, 33, 0.2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .related-block {
    margin-block-start: 2.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-card {
    padding: 1.15rem;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .related-card:hover {
    border-color: var(--accent-orange);
  }

  .related-card span {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
  }

  @media (max-width: 920px) {
    .sol-hero-grid,
    .sol-detail-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { saveStarterIdea } from "@/lib/project/storage";

  document.querySelectorAll<HTMLAnchorElement>("[data-start-category]").forEach((link) => {
    link.addEventListener("click", () => {
      const category = link.dataset.startCategory || null;
      const prompt = link.dataset.startPrompt || "";
      if (prompt) saveStarterIdea(prompt, category);
    });
  });
</script>
