---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

const canonical = `${site.url}/nosotros/`;

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Studio & Manifesto | ENIX STUDIO",
  url: canonical,
  description:
    "Conoce ENIX STUDIO: consultoría estratégica, dirección de arte e ingeniería industrial para organizaciones que compiten en ligas mayores.",
  mainEntity: {
    "@type": "Organization",
    name: site.name,
    alternateName: "ENIX STUDIO",
    url: site.url,
    brand: { "@type": "Brand", name: "ENIX STUDIO" },
    foundingDate: "2017",
  },
};

const tenets = [
  {
    num: "01",
    title: "Direct Partner Supervision",
    subtitle: "Atención Directa de Socios",
    desc: "Eliminamos las capas intermedias de ejecutivos junior y burocracia de agencia. Cada proyecto es analizado, estructurado y supervisado directamente por nuestros socios directores de estrategia, dirección de arte y tecnología.",
  },
  {
    num: "02",
    title: "Economic Stakes First",
    subtitle: "Impacto Económico Medible",
    desc: "El buen diseño no es cosmética ni arte decorativo; es la herramienta comercial más rentable para justificar precios premium, ganar licitaciones corporativas y elevar el valor patrimonial de su compañía.",
  },
  {
    num: "03",
    title: "Where Digital Meets Industrial",
    subtitle: "Ingeniería Profunda con NOVVOR",
    desc: "Mantenemos independencia creativa absoluta, pero cuando una iniciativa demanda ingeniería física —hardware, carcasas de sensores IoT, interfaces HMI de maquinaria pesada o infraestructura cloud masiva—, desplegamos la fuerza de NOVVOR.",
  },
];
---

<BaseLayout
  title="Studio & Manifesto | ENIX STUDIO"
  description="Conoce la visión, principios directivos y capacidades de ENIX STUDIO. Consultoría estratégica, dirección de arte e ingeniería respaldada por NOVVOR."
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Studio", url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">
    {/* Hero Section */}
    <section class="px-4 md:px-8 pb-16 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Studio Profile · Operating Worldwide
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight max-w-5xl">
          Independent in thought.<br />
          Backed by industrial engineering.
        </h1>
        <p class="mt-8 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          ENIX Studio fue fundado en 2017 para ofrecer una alternativa rigurosa al modelo tradicional de agencias: sin estructuras infladas, sin plantillas genéricas y con un compromiso irrestricto por defender la posición competitiva de nuestros clientes.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-6 font-mono text-xs text-neutral-400 pt-6 border-t border-white/10">
          <div>
            <span class="text-neutral-500 block text-[10px] uppercase mb-0.5">Fundación</span>
            <span class="text-white font-bold">Est. 2017</span>
          </div>
          <span class="text-neutral-700">/</span>
          <div>
            <span class="text-neutral-500 block text-[10px] uppercase mb-0.5">Alcance</span>
            <span class="text-white font-bold">Global Practice (Remote Worldwide)</span>
          </div>
          <span class="text-neutral-700">/</span>
          <div>
            <span class="text-neutral-500 block text-[10px] uppercase mb-0.5">Alianza Industrial</span>
            <span class="text-white font-bold">Powered by NOVVOR</span>
          </div>
        </div>
      </div>
    </section>

    {/* Studio Photography Showcase */}
    <section class="py-16 md:py-24 px-4 md:px-8 border-b border-white/10 bg-[#050505]">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 group relative rounded-2xl md:rounded-3xl border border-white/10 overflow-hidden aspect-[16/10] shadow-2xl bg-neutral-950">
          <img
            src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=85"
            alt="ENIX Studio Architecture & Environment"
            width="1600"
            height="1000"
            decoding="async"
            class="w-full h-full object-cover object-center filter brightness-90 contrast-105 transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-6 flex items-end justify-between">
            <span class="text-xs font-mono uppercase tracking-widest text-neutral-300">
              Workspace & Design Practice
            </span>
            <span class="text-xs font-mono text-neutral-400">
              Global Advisory
            </span>
          </div>
        </div>

        <div class="lg:col-span-5 group relative rounded-2xl md:rounded-3xl border border-white/10 overflow-hidden aspect-[16/10] shadow-2xl bg-neutral-950">
          <img
            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=85"
            alt="ENIX Leadership & Strategic Collaboration"
            width="1600"
            height="1000"
            decoding="async"
            class="w-full h-full object-cover object-center filter brightness-85 contrast-105 transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-6 flex items-end justify-between">

            <span class="text-xs font-mono uppercase tracking-widest text-neutral-300">
              C-Level Advisory Sessions
            </span>
            <span class="text-xs font-mono text-neutral-400">
              NDA Protected
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* Non-Negotiable Tenets */}
    <section class="py-24 md:py-32 px-4 md:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-16">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block mb-3">
            Core Principles
          </span>
          <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Nuestros principios innegociables.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {tenets.map((tenet) => (
            <article class="p-8 rounded-3xl border border-white/10 bg-neutral-900/40 space-y-6 flex flex-col justify-between">
              <div class="space-y-4">
                <span class="font-mono text-sm text-neutral-500 block">
                  {tenet.num}
                </span>
                <h3 class="text-2xl font-bold text-white tracking-tight">
                  {tenet.title}
                </h3>
                <p class="text-xs font-mono uppercase tracking-wider text-neutral-400">
                  {tenet.subtitle}
                </p>
                <p class="text-sm text-neutral-300 leading-relaxed font-light">
                  {tenet.desc}
                </p>
              </div>
              <div class="pt-4 border-t border-white/10 font-mono text-[11px] text-neutral-500">
                Pilar Estratégico ENIX
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Executive CTA */}
    <section class="py-24 px-4 md:px-8 border-t border-white/10 bg-[#050505] text-center">
      <div class="max-w-4xl mx-auto space-y-6">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Collaborate with Leadership
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
          Inicie una conversación con nuestros socios directores.
        </h2>
        <p class="text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
          Evaluamos confidencialmente cada iniciativa para verificar compatibilidad de visión y disponibilidad de agenda.
        </p>
        <div class="pt-4">
          <a href="/contacto/" class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-8 py-3.5 hover:bg-neutral-200">
            Start a Project ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
