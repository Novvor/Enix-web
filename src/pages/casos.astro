---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import { consultingCases } from "@/data/selectedWorkData";
import { site } from "@/data/site";

const canonical = `${site.url}/casos/`;

const casesPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Work & Consulting Cases | ENIX STUDIO",
  url: canonical,
  description:
    "Casos de consultoría estratégica, dirección de arte e ingeniería aplicada desarrollados por ENIX STUDIO en industrias de alto valor.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: consultingCases.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      description: item.challenge,
    })),
  },
};
---

<BaseLayout
  title="Work & Consulting Cases | ENIX STUDIO"
  description="Casos de consultoría estratégica, dirección de arte e ingeniería industrial para empresas consolidadas, fondos de inversión y líderes de industria."
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Work", url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(casesPageSchema)} />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">

    {/* Hero Section */}
    <section class="px-4 md:px-8 pb-16 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Selected Consulting Engagements · Proven Impact
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight max-w-5xl">
          Transformaciones estratégicas en industrias de alto valor.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          No mostramos maquetas superficiales. Cada proyecto documenta una intervención consultiva integral donde resolvimos cuellos de botella comerciales, reposicionamos la marca y desplegamos tecnología de misión crítica con el respaldo de NOVVOR.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4 text-xs font-mono uppercase tracking-wider text-neutral-400">
          <span class="px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.04]">Heavy Industry & Mining</span>
          <span class="px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.04]">Real Estate & Private Equity</span>
          <span class="px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.04]">Advanced Healthcare</span>
          <span class="px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.04]">Powered by NOVVOR</span>
        </div>
      </div>
    </section>

    {/* Consulting Cases Deep Dive */}
    <section class="py-24 md:py-32 px-4 md:px-8">
      <div class="max-w-7xl mx-auto space-y-28 md:space-y-36">
        {consultingCases.map((item) => (
          <article class="p-8 md:p-14 rounded-3xl border border-white/10 bg-neutral-900/40 space-y-12">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">
                  {item.tag}
                </span>
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                <span class="font-mono text-xs uppercase tracking-wider text-neutral-300">
                  {item.industry}
                </span>
              </div>
              <div class="font-mono text-xs px-3 py-1.5 rounded-full bg-white/[0.06] border border-white/10 text-white font-semibold self-start sm:self-auto">
                {item.dealValue}
              </div>
            </div>

            <div class="max-w-4xl space-y-3">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500 block">
                {item.client} · {item.year}
              </span>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight">
                {item.title}
              </h2>
            </div>

            {/* High-Resolution Project Showcase Image */}
            <div class="overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 bg-neutral-950 aspect-[21/9] shadow-2xl relative">
              <img
                src={item.image}
                alt={item.title}
                width="1600"
                height="685"
                decoding="async"
                class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-6 flex items-end justify-between">
                <span class="font-mono text-xs text-white/80 uppercase tracking-widest bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
                  {item.client} · Corporate Case File
                </span>
                <span class="font-mono text-xs text-white/70">
                  Engineering Scope: Full Integration
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pt-4">

              <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-3">
                <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 block">
                  01 / Desafío de Negocio
                </span>
                <p class="text-sm text-neutral-300 leading-relaxed font-light">
                  {item.challenge}
                </p>
              </div>

              <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-3">
                <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 block">
                  02 / Intervención Consultiva & Estratégica
                </span>
                <ul class="space-y-2.5">
                  {item.consultingScope.map((scope) => (
                    <li class="text-xs text-neutral-300 flex items-start gap-2 leading-relaxed">
                      <span class="text-red-500 font-bold">›</span>
                      <span>{scope}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-4">
                <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 block">
                  03 / Impacto Económico & Músculo NOVVOR
                </span>
                <div class="space-y-3">
                  <p class="text-xs font-semibold text-white leading-relaxed">
                    {item.economicImpact}
                  </p>
                  {item.novvorIntegration && (
                    <div class="pt-3 border-t border-white/10">
                      <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 block mb-1">
                        Ingeniería Industrial NOVVOR:
                      </span>
                      <p class="text-xs text-neutral-400 leading-relaxed font-light">
                        {item.novvorIntegration}
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-wrap gap-2">
                {item.deliverables.map((deliv) => (
                  <span class="text-[11px] font-mono px-3 py-1 rounded-full border border-white/10 bg-white/[0.04] text-neutral-300">
                    {deliv}
                  </span>
                ))}
              </div>
              <a
                href="/contacto/"
                class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-white hover:text-neutral-300 transition"
              >
                Discutir un proyecto similar <span>↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Executive CTA to Start a Project */}
    <section class="py-24 px-4 md:px-8 border-t border-white/10 bg-[#050505] text-center">
      <div class="max-w-4xl mx-auto space-y-6">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Advisory & Consultation
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
          ¿Tiene un desafío de negocio o tecnología similar?
        </h2>
        <p class="text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
          Cada proyecto es evaluado bajo acuerdos estrictos de confidencialidad y supervisión de socios directores.
        </p>
        <div class="pt-4">
          <a href="/contacto/" class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-8 py-3.5 hover:bg-neutral-200">
            Iniciar Evaluación de Proyecto ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
