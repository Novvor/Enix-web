---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import ProjectInquiry from "@/components/home/ProjectInquiry";
import { site } from "@/data/site";

const canonical = `${site.url}/contacto/`;

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Start a Project | ENIX STUDIO",
  url: canonical,
  description:
    "Solicite una evaluación estratégica con la dirección de ENIX STUDIO. Consultoría, dirección de arte e ingeniería de alto impacto.",
  mainEntity: {
    "@type": "Organization",
    name: site.name,
    alternateName: "ENIX STUDIO",
    email: site.email,
    url: site.url,
    brand: { "@type": "Brand", name: "ENIX STUDIO" },
  },
};
---

<BaseLayout
  title="Start a Project | ENIX STUDIO"
  description="Inicie la evaluación estratégica de su proyecto. ENIX Studio acepta un número limitado de compromisos trimestrales con supervisión directa de socios directores."
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Start a Project", url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <main class="min-h-screen pt-28 md:pt-36 bg-[#0A0A0A] text-[#F7F7F4]">
    {/* Page Header */}
    <div class="px-4 md:px-8 pb-12 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Selective Engagements · Confidential Advisory
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight">
          Start a Project.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          Trabajamos con un número deliberadamente limitado de marcas e industrias por trimestre para involucrarnos de forma directa y personal a nivel de directorio. Complete el formulario de calificación a continuación para evaluar encaje y disponibilidad.
        </p>
      </div>
    </div>

    {/* Dedicated Project Qualification Intake */}
    <ProjectInquiry client:load />

    {/* Protocols & Assurances */}
    <section class="py-20 px-4 md:px-8 border-t border-white/10 bg-[#050505]">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-2">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-widest block">01 / Direct Partner Access</span>
          <h3 class="text-lg font-bold text-white">Atención Directa de Socios</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-light">
            Su iniciativa no será delegada a ejecutivos de cuentas junior. Cada proyecto es analizado y liderado por nuestros socios directores de estrategia, arte y tecnología.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-2">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-widest block">02 / Strict NDA & Discretion</span>
          <h3 class="text-lg font-bold text-white">Confidencialidad Garantizada</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-light">
            Firmamos acuerdos de confidencialidad estrictos (NDA) previo a la revisión de modelos de negocio, métricas operativas o propiedad intelectual sensible.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-2">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-widest block">03 / Rapid Assessment</span>
          <h3 class="text-lg font-bold text-white">Respuesta en 24 Horas Hábiles</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-light">
            Evaluamos la compatibilidad estratégica en un plazo máximo de 24 a 48 horas hábiles para coordinar una sesión de trabajo ejecutiva o derivar responsablemente.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
