---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import InteractiveDemos from "@/components/marketing/InteractiveDemos";
import { demonstrations } from "@/content/demonstrations";
---

<MarketingLayout
  title="Demostraciones interactivas — ENIX Studio"
  description="Prueba tres recorridos funcionales con datos de ejemplo: reservas, gestión de pedidos y automatización de solicitudes."
>
  <section class="section">
    <div class="container">
      <div class="demo-page-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Ejemplos funcionales · Datos de ejemplo</span>
        </div>
        <h1 class="heading-xl">Prueba cómo diseñamos y resolvemos flujos reales</h1>
        <p class="lead">
          Cada demostración utiliza datos de ejemplo y no requiere registro. Sirven para mostrarte el nivel de claridad, interacción y estructura que aplicamos a los proyectos de ENIX Studio.
        </p>
      </div>

      <InteractiveDemos client:load compact={true} darkSurface={false} />

      <div class="demo-cards-grid">
        {demonstrations.map((demo) => (
          <article class="demo-list-card">
            <span class="demo-card-tag">{demo.tag}</span>
            <h2 class="heading-md">{demo.title}</h2>
            <p class="demo-card-copy">{demo.businessNeed}</p>
            <div style="margin-block-start: auto; padding-block-start: 0.75rem;">
              <a href={`/demos/${demo.slug}/`} class="btn btn-secondary btn-sm">
                Abrir demostración individual →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .demo-page-head {
    max-inline-size: 780px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-block-end: 2.5rem;
  }

  .demo-cards-grid {
    margin-block-start: 3rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .demo-list-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .demo-card-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-deep);
  }

  .demo-card-copy {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .demo-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
