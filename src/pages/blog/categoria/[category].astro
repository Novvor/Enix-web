---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import { blogCategories, categorySlug, getArticlesByCategory } from "@/data/blogData";
import { site } from "@/data/site";

export const prerender = true;

export function getStaticPaths() {
  return blogCategories.map((category) => ({
    params: { category: categorySlug(category) },
    props: { category, articles: getArticlesByCategory(categorySlug(category)) },
  }));
}

const { category, articles } = Astro.props;
const canonical = `${site.url}/blog/categoria/${categorySlug(category)}/`;
---

<BaseLayout
  title={`${category} | Insights & Perspectives | ENIX STUDIO`}
  description={`Ensayos y perspectivas sobre ${category} para líderes de negocio, directores e inversionistas.`}
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Insights", url: `${site.url}/blog/` }, { name: category, url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">
    <section class="px-4 md:px-8 pb-16 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Insights · Disciplina
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight max-w-5xl">
          {category}
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          Perspectivas directivas y análisis técnico aplicados a {category.toLowerCase()} para organizaciones de alta exigencia.
        </p>

        <div class="mt-8">
          <a href="/blog/" class="text-xs font-mono uppercase tracking-widest text-neutral-400 hover:text-white transition flex items-center gap-2">
            ← Volver a todos los ensayos
          </a>
        </div>
      </div>
    </section>

    <section class="py-24 px-4 md:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <article class="group rounded-3xl border border-white/10 bg-neutral-900/30 hover:bg-neutral-900/60 hover:border-white/20 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <a href={`/blog/${article.slug}/`} class="block overflow-hidden aspect-[16/9] bg-neutral-950 border-b border-white/10 relative">
                <img
                  src={article.coverImage}
                  alt={article.coverAlt}
                  class="w-full h-full object-cover object-center filter brightness-85 contrast-105 transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              </a>

              <div class="p-6 md:p-8 space-y-4 flex-1 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
                    <span class="text-neutral-400 uppercase tracking-wider">{article.category}</span>
                    <span>{article.readingTime}</span>
                  </div>

                  <h2 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-neutral-200 transition">
                    <a href={`/blog/${article.slug}/`}>{article.title}</a>
                  </h2>

                  <p class="text-xs sm:text-sm text-neutral-400 font-light leading-relaxed line-clamp-3">
                    {article.description}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-neutral-400">{article.updatedAt}</span>
                  <a
                    href={`/blog/${article.slug}/`}
                    class="text-xs font-mono uppercase tracking-wider text-white hover:text-neutral-300 transition flex items-center gap-1 group-hover:translate-x-1"
                  >
                    Leer <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {/* Executive CTA to Start a Project */}
        <div class="mt-20 p-8 md:p-14 rounded-3xl border border-white/10 bg-neutral-900/60 text-center space-y-6 max-w-4xl mx-auto">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
            Executive Consultation
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            ¿Busca implementar una iniciativa en {category}?
          </h2>
          <p class="text-sm md:text-base text-neutral-300 font-light leading-relaxed max-w-xl mx-auto">
            Abordamos proyectos complejos con criterio comercial, acuerdos de confidencialidad y supervisión directa de socios directores.
          </p>
          <div class="pt-2">
            <a class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-8 py-3.5 hover:bg-neutral-200" href="/contacto/">
              Iniciar Evaluación de Proyecto ↗
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
