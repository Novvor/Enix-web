---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import { blogArticles, blogCategories, categorySlug } from "@/data/blogData";
import { site } from "@/data/site";

const canonical = `${site.url}/blog/`;

const featured = blogArticles[0];
const restArticles = blogArticles.slice(1);

const blogPageSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Insights & Perspectives | ENIX STUDIO",
  url: canonical,
  description:
    "Análisis directivos, visión estratégica y criterios de ingeniería digital publicados por ENIX STUDIO.",
};
---

<BaseLayout
  title="Insights & Perspectives | ENIX STUDIO"
  description="Ensayos, análisis estratégicos y criterios de ingeniería para líderes de negocio, directores e inversionistas."
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Insights", url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPageSchema)} />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">

    {/* Page Header */}
    <section class="px-4 md:px-8 pb-16 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Insights · Thought Leadership
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight max-w-5xl">
          Estrategia, percepción e ingeniería digital.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          Análisis directivos y perspectivas sobre modelos de negocio, posicionamiento de autoridad, arquitectura tecnológica y el impacto de la ingeniería industrial en mercados competitivos.
        </p>

        {/* Categories Bar */}
        <div class="mt-10 flex flex-wrap items-center gap-2 pt-6 border-t border-white/10">
          <span class="text-xs font-mono uppercase tracking-widest text-neutral-500 mr-2">
            Disciplines:
          </span>
          {blogCategories.map((category) => (
            <a
              class="px-3.5 py-1.5 rounded-full border border-white/10 bg-white/[0.03] text-xs font-mono text-neutral-300 hover:border-white/25 hover:text-white hover:bg-white/[0.08] transition"
              href={`/blog/categoria/${categorySlug(category)}/`}
            >
              {category}
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Featured Essay Showcase */}
    <section class="py-16 md:py-24 px-4 md:px-8 border-b border-white/10 bg-[#070707]">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block mb-6">
          Featured Perspective
        </span>
        <a
          href={`/blog/${featured.slug}/`}
          class="group block p-8 md:p-12 rounded-3xl border border-white/10 bg-neutral-900/40 hover:border-white/25 transition-all duration-300"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
            <div class="lg:col-span-7 space-y-6">
              <div class="flex items-center gap-3 font-mono text-xs text-neutral-400">
                <span class="text-red-500 uppercase tracking-wider font-semibold">{featured.category}</span>
                <span>·</span>
                <span>{featured.readingTime}</span>
                <span>·</span>
                <span>{featured.updatedAt}</span>
              </div>

              <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight group-hover:text-neutral-200 transition">
                {featured.title}
              </h2>

              <p class="text-sm md:text-base text-neutral-300 font-light leading-relaxed">
                {featured.description}
              </p>

              <div class="pt-2 flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-white group-hover:translate-x-1 transition-transform">
                <span>Leer ensayo completo</span>
                <span>→</span>
              </div>
            </div>

            <div class="lg:col-span-5 overflow-hidden rounded-2xl border border-white/10 bg-neutral-950 aspect-[16/10]">
              <img
                src={featured.coverImage}
                alt={featured.coverAlt}
                class="w-full h-full object-cover object-center filter brightness-90 contrast-105 transition-transform duration-700 ease-out group-hover:scale-105"
                loading="eager"
              />
            </div>
          </div>
        </a>
      </div>
    </section>

    {/* Articles Grid */}
    <section class="py-24 md:py-32 px-4 md:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {restArticles.map((article) => (
            <article class="group rounded-3xl border border-white/10 bg-neutral-900/30 hover:bg-neutral-900/60 hover:border-white/20 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <a href={`/blog/${article.slug}/`} class="block overflow-hidden aspect-[16/9] bg-neutral-950 border-b border-white/10 relative">
                <img
                  src={article.coverImage}
                  alt={article.coverAlt}
                  class="w-full h-full object-cover object-center filter brightness-85 contrast-105 transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              </a>

              <div class="p-6 md:p-8 space-y-4 flex-1 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
                    <a
                      href={`/blog/categoria/${categorySlug(article.category)}/`}
                      class="text-neutral-400 hover:text-white uppercase tracking-wider transition"
                    >
                      {article.category}
                    </a>
                    <span>{article.readingTime}</span>
                  </div>

                  <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-neutral-200 transition">
                    <a href={`/blog/${article.slug}/`}>{article.title}</a>
                  </h3>

                  <p class="text-xs sm:text-sm text-neutral-400 font-light leading-relaxed line-clamp-3">
                    {article.description}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-neutral-400">{article.updatedAt}</span>
                  <a
                    href={`/blog/${article.slug}/`}
                    class="text-xs font-mono uppercase tracking-wider text-white hover:text-neutral-300 transition flex items-center gap-1 group-hover:translate-x-1"
                  >
                    Leer <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>


    {/* Executive CTA to Start a Project */}
    <section class="py-24 px-4 md:px-8 border-t border-white/10 bg-[#050505] text-center">
      <div class="max-w-4xl mx-auto space-y-6">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Strategic Advisory
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
          Lleve estas reflexiones a la práctica en su empresa.
        </h2>
        <p class="text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
          Estructuramos proyectos a medida para organizaciones que buscan transformar su percepción y tecnología.
        </p>
        <div class="pt-4">
          <a href="/contacto/" class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-8 py-3.5 hover:bg-neutral-200">
            Start a Project ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
