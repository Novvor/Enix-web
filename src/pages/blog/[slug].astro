---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import ReadingProgress from "@/components/ReadingProgress";
import SocialShare from "@/components/SocialShare.astro";
import { blogArticles, categorySlug, type BlogArticle } from "@/data/blogData";
import { site } from "@/data/site";

export const prerender = true;

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const canonical = `${site.url}/blog/${article.slug}/`;
const related = article.related
  .map((slug) => blogArticles.find((item) => item.slug === slug))
  .filter((item): item is BlogArticle => Boolean(item));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  image: article.coverImage.startsWith("http") ? article.coverImage : `${site.url}${article.coverImage}`,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt,
  author: { "@type": "Organization", name: article.author, url: site.url },
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: canonical,
  keywords: article.keywords.join(", "),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faq.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<BaseLayout
  title={`${article.title} | ENIX STUDIO`}
  description={article.description}
  canonical={canonical}
  ogImage={article.coverImage}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Insights", url: `${site.url}/blog/` }, { name: article.title, url: canonical }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header currentPath={Astro.url.pathname} client:load />
  <ReadingProgress client:idle />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">
    <article data-reading-content>
      {/* Editorial Essay Header */}
      <header class="px-4 md:px-8 pb-14 border-b border-white/10">
        <div class="max-w-4xl mx-auto space-y-6">
          <div class="flex items-center gap-3 font-mono text-xs text-neutral-400">
            <a
              class="text-red-500 font-semibold uppercase tracking-wider hover:underline"
              href={`/blog/categoria/${categorySlug(article.category)}/`}
            >
              {article.category}
            </a>
            <span>·</span>
            <span>{article.readingTime}</span>
            <span>·</span>
            <time datetime={article.publishedAt}>Actualizado {article.updatedAt}</time>
          </div>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight">
            {article.title}
          </h1>

          <p class="text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
            {article.description}
          </p>

          <div class="pt-4 flex items-center justify-between border-t border-white/10 text-xs font-mono text-neutral-400">
            <span>Dirección Editorial · {article.author}</span>
            <SocialShare url={canonical} title={article.title} variant="dark" />
          </div>
        </div>
      </header>

      {/* Featured Header Image */}
      <div class="px-4 md:px-8 py-8 max-w-5xl mx-auto">
        <div class="overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 bg-neutral-950 aspect-[16/9] shadow-2xl">
          <img
            src={article.coverImage}
            alt={article.coverAlt}
            class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
            loading="eager"
          />
        </div>
      </div>

      {/* Essay Body & Sidebar */}
      <section class="py-12 px-4 md:px-8">
        <div class="max-w-5xl mx-auto grid gap-12 lg:grid-cols-[0.3fr_0.7fr]">
          <aside class="lg:sticky lg:top-28 lg:self-start space-y-6">
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
              <p class="font-mono text-xs uppercase tracking-widest text-neutral-400 mb-3">Estructura</p>
              <ol class="grid gap-2 text-xs font-mono text-neutral-400">
                {article.sections.map((section) => (
                  <li>
                    <a
                      class="hover:text-white transition block py-1"
                      href={`#${section.heading.toLowerCase().replaceAll(" ", "-").replaceAll(":", "")}`}
                    >
                      {section.heading}
                    </a>
                  </li>
                ))}
              </ol>
            </div>

            <div class="p-5 rounded-2xl border border-white/10 bg-white/[0.02] space-y-3 font-mono text-xs text-neutral-400">
              <span class="text-white block font-bold">ENIX Advisory</span>
              <p class="text-[11px] leading-relaxed text-neutral-400">
                Proyectos ejecutados con estricto acuerdo de confidencialidad y supervisión directa de socios.
              </p>
              <a href="/contacto/" class="text-white hover:underline block pt-2">
                Iniciar conversación ↗
              </a>
            </div>
          </aside>

          <div class="max-w-2xl space-y-10 text-neutral-300 font-light text-base md:text-lg leading-relaxed">
            <p class="text-xl md:text-2xl font-medium text-white leading-relaxed border-l-2 border-red-500 pl-6 py-1">
              {article.intro}
            </p>

            {article.sections.map((section) => (
              <section id={section.heading.toLowerCase().replaceAll(" ", "-").replaceAll(":", "")} class="scroll-mt-28 space-y-4">
                <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white pt-6">
                  {section.heading}
                </h2>
                {section.body.map((paragraph) => (
                  <p class="text-neutral-300 leading-relaxed font-light">
                    {paragraph}
                  </p>
                ))}
                {section.bullets && (
                  <ul class="grid gap-2.5 pt-2">
                    {section.bullets.map((bullet) => (
                      <li class="flex items-start gap-3 rounded-xl border border-white/5 bg-white/[0.02] p-3 text-xs md:text-sm text-neutral-300">
                        <span class="text-red-500 font-bold">›</span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}

            {/* Practical Examples */}
            <section class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 md:p-8 space-y-4">
              <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block">
                Casos Prácticos & Evidencia
              </span>
              <ul class="grid gap-3">
                {article.examples.map((example) => (
                  <li class="flex items-start gap-3 text-xs md:text-sm text-neutral-300 leading-relaxed">
                    <span class="text-red-500 font-bold">›</span>
                    <span>{example}</span>
                  </li>
                ))}
              </ul>
            </section>

            {/* Executive Recommended Solution Callout */}
            <section class="rounded-3xl border border-white/10 bg-neutral-900/60 p-8 md:p-10 space-y-6">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
                Capacidad Relacionada · ENIX STUDIO
              </span>
              <h3 class="text-2xl md:text-3xl font-black text-white">
                {article.serviceRelated}
              </h3>
              <p class="text-sm md:text-base text-neutral-300 leading-relaxed font-light">
                {article.recommendedSolution}
              </p>
              <div class="pt-2 flex flex-wrap gap-4">
                <a class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-6 py-3 hover:bg-neutral-200" href="/contacto/">
                  Iniciar Evaluación de Proyecto ↗
                </a>
                <a class="btn-editorial btn-editorial-outline-white text-xs px-6 py-3" href="/servicios/">
                  Explorar capacidades directivas
                </a>
              </div>
            </section>

            {/* Frequently Asked Questions */}
            {article.faq && article.faq.length > 0 && (
              <section class="space-y-4 pt-4">
                <h3 class="text-2xl font-black text-white">Criterios & Preguntas Frecuentes</h3>
                <div class="grid gap-3">
                  {article.faq.map(([question, answer]) => (
                    <details class="rounded-2xl border border-white/10 bg-white/[0.02] p-5 group">
                      <summary class="cursor-pointer font-bold text-white text-sm flex items-center justify-between">
                        <span>{question}</span>
                        <span class="text-neutral-500 group-open:rotate-45 transition-transform font-mono text-lg">+</span>
                      </summary>
                      <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                        {answer}
                      </p>
                    </details>
                  ))}
                </div>
              </section>
            )}

            {/* Related Articles */}
            {related.length > 0 && (
              <section class="space-y-4 pt-8 border-t border-white/10">
                <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block">
                  Perspectivas Relacionadas
                </span>
                <div class="grid gap-4 md:grid-cols-2">
                  {related.map((item) => (
                    <a
                      class="p-5 rounded-2xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition space-y-2 block"
                      href={`/blog/${item.slug}/`}
                    >
                      <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider">{item.category}</span>
                      <p class="font-bold text-white text-sm leading-snug">{item.title}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>
