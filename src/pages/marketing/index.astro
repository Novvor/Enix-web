---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { primaryMarketingServices, brandComplementaryService } from "@/content/marketing";
import { siteConfig } from "@/content/site";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Marketing", path: "/marketing/" }
  ])
];
---

<MarketingLayout
  title="Marketing digital y marca — ENIX Studio"
  description="Estrategia digital, publicidad en Google Ads y Meta Ads, SEO y presencia local, contenido, email comercial, analítica y diseño de marca conectados a tu experiencia digital."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="mkt-page-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Marketing digital y crecimiento</span>
        </div>
        <h1 class="heading-xl">Conectamos estrategia, contenido y campañas con la experiencia digital de tu negocio</h1>
        <p class="lead">
          No sirve atraer visitas a una web confusa ni lanzar una plataforma sin un plan para darla a conocer. En ENIX Studio unimos marca, marketing digital y desarrollo en un mismo equipo.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.35rem;">
          <a href="/create-project/?category=marketing" class="btn btn-primary">
            Definir mi plan de marketing →
          </a>
          <a href="/contact/" class="btn btn-secondary">Hablar con el equipo</a>
        </div>
      </div>

      <!-- Qué objetivos aborda -->
      <div class="mkt-objectives-strip">
        <div class="mkt-obj-card">
          <strong>Atraer clientes con intención real</strong>
          <p>Ordenamos mensajes, búsqueda local y campañas para llegar a quienes realmente necesitan tu servicio.</p>
        </div>
        <div class="mkt-obj-card">
          <strong>Convertir mejor cada visita</strong>
          <p>Alineamos páginas de captación, formularios y seguimiento para no perder oportunidades ya ganadas.</p>
        </div>
        <div class="mkt-obj-card">
          <strong>Medir con criterios honestos</strong>
          <p>Acordamos indicadores reales según tu negocio. Nunca prometemos ventas garantizadas ni posiciones fijas en buscadores.</p>
        </div>
      </div>

      <!-- 6 Líneas de servicio -->
      <div class="mkt-section-block">
        <h2 class="heading-lg" style="margin-block-end: 1.5rem;">Servicios de marketing digital</h2>
        <div class="mkt-catalog-grid">
          {primaryMarketingServices.map((srv) => (
            <article class="mkt-service-card">
              <span class="mkt-service-eyebrow">{srv.eyebrow}</span>
              <h3 class="heading-md">{srv.name}</h3>
              <p class="mkt-service-desc">{srv.intro}</p>
              <div class="mkt-deliv-box">
                <span>Qué puedes recibir:</span>
                <ul>
                  {srv.deliverables.slice(0, 3).map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
              <div class="mkt-service-actions">
                <a href={`/marketing/${srv.slug}/`} class="btn btn-secondary btn-sm">
                  Explorar {srv.name.toLowerCase()}
                </a>
                <a
                  href={`/create-project/?category=${srv.slug}`}
                  class="btn btn-primary btn-sm"
                  data-mkt-prompt={srv.starterPrompt}
                  data-mkt-slug={srv.slug}
                >
                  Definir {srv.name.toLowerCase()} →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Servicio complementario: Branding -->
      <div class="mkt-section-block">
        <article class="brand-full-panel">
          <div style="display:flex; flex-direction:column; gap:0.75rem; align-items:flex-start;">
            <span class="eyebrow" style="background: var(--bg-surface);">
              <span class="eyebrow-dot" aria-hidden="true"></span>
              <span>Servicio complementario · Marca</span>
            </span>
            <h2 class="heading-lg">{brandComplementaryService.name}</h2>
            <p class="lead" style="font-size: var(--text-sm);">
              {brandComplementaryService.intro}
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.65rem; margin-top:0.35rem;">
              <a href="/marketing/brand-design/" class="btn btn-secondary btn-sm">Ver alcance de marca →</a>
              <a
                href="/create-project/?category=brand-design"
                class="btn btn-primary btn-sm"
                data-mkt-prompt={brandComplementaryService.starterPrompt}
                data-mkt-slug="brand-design"
              >
                Definir proyecto de marca
              </a>
            </div>
          </div>

          <div class="brand-diff-grid">
            <div class="brand-diff-card">
              <h3>Identidad de marca completa</h3>
              <p>
                Para negocios nuevos o en reposicionamiento: sistema visual, paleta, tipografía, tono de mensajes, usos del logo y guía base para web y comunicaciones.
              </p>
            </div>
            <div class="brand-diff-card">
              <h3>Diseño de piezas para campaña</h3>
              <p>
                Para empresas que ya tienen identidad y necesitan creativos para anuncios, páginas de captación, presentaciones o publicaciones con un alcance puntual.
              </p>
            </div>
          </div>
        </article>
      </div>

      <!-- Estrategia, modalidad e indicadores -->
      <div class="mkt-section-block mkt-governance-grid">
        <article class="gov-card">
          <h2 class="heading-md">Trabajo puntual vs. acompañamiento periódico</h2>
          <p>
            Puedes iniciar con un <strong>trabajo puntual</strong> (diagnóstico, estrategia, optimización SEO inicial, páginas de captación o automatización comercial) o continuar con un <strong>acompañamiento periódico</strong> mensual para campañas, contenido y optimización continua.
          </p>
        </article>

        <article class="gov-card">
          <h2 class="heading-md">Inversión publicitaria separada de honorarios</h2>
          <p>
            La <strong>inversión en anuncios</strong> (Google Ads, Meta Ads) se paga directamente desde tus cuentas publicitarias. Los <strong>honorarios de ENIX</strong> cubren estrategia, diseño, implementación y gestión acordada. Ambos se definen por separado.
          </p>
        </article>

        <article class="gov-card">
          <h2 class="heading-md">Cómo se acuerdan y revisan los indicadores</h2>
          <p>
            Definimos indicadores concretos antes de comenzar (consultas calificadas, reservas, tasa de conversión o costo por oportunidad) y los revisamos en conjunto. No prometemos ventas garantizadas ni retornos automáticos.
          </p>
        </article>
      </div>

      <!-- Conexión con soluciones tecnológicas -->
      <div class="mkt-section-block tech-bridge-panel">
        <div>
          <h2 class="heading-md">Conectado con nuestras soluciones tecnológicas</h2>
          <p style="font-size: var(--text-sm); color: var(--ink-secondary); margin-top: 0.4rem; max-inline-size: 620px;">
            Cuando tu plan requiere páginas de captación rápidas, agenda de reservas, integraciones con CRM o automatizaciones, el mismo equipo lo resuelve sin fricción entre agencias.
          </p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:0.55rem;">
          <a href="/solutions/websites/" class="btn btn-secondary btn-sm">Sitios web y landings</a>
          <a href="/solutions/automations/" class="btn btn-secondary btn-sm">Automatizaciones</a>
          <a href="/solutions/management-systems/" class="btn btn-secondary btn-sm">Sistemas de gestión</a>
        </div>
      </div>

      <p style="font-size: var(--text-xs); color: var(--ink-muted); margin-block-start: 1.5rem;">
        {siteConfig.responsibilityStatement} La web y el asistente permiten definir tu ficha de proyecto; ninguna campaña se activa ni modifica cuentas publicitarias automáticamente.
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .mkt-page-head {
    max-inline-size: 820px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-block-end: 2.5rem;
  }

  .mkt-objectives-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-block-end: 3rem;
  }

  .mkt-obj-card {
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .mkt-obj-card strong {
    display: block;
    font-size: var(--text-sm);
    margin-block-end: 0.35rem;
  }

  .mkt-obj-card p {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .mkt-section-block {
    margin-block-start: 3rem;
  }

  .mkt-catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .mkt-service-card {
    padding: 1.65rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .mkt-service-eyebrow {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-deep);
  }

  .mkt-service-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.6;
  }

  .mkt-deliv-box {
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
  }

  .mkt-deliv-box span {
    display: block;
    font-weight: 700;
    color: var(--ink-primary);
    margin-block-end: 0.4rem;
  }

  .mkt-deliv-box ul {
    padding-inline-start: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--ink-secondary);
  }

  .mkt-service-actions {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .brand-full-panel {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border: 1px solid rgba(243, 75, 33, 0.2);
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2rem;
    align-items: center;
  }

  .brand-diff-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  .brand-diff-card {
    padding: 1.2rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .brand-diff-card h3 {
    font-size: 0.98rem;
    margin-block-end: 0.3rem;
  }

  .brand-diff-card p {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .mkt-governance-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .gov-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .gov-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.6;
  }

  .tech-bridge-panel {
    padding: 1.65rem 2rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .mkt-objectives-strip,
    .mkt-catalog-grid,
    .brand-full-panel,
    .mkt-governance-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { saveStarterIdea } from "@/lib/project/storage";

  document.querySelectorAll<HTMLAnchorElement>("[data-mkt-prompt]").forEach((el) => {
    el.addEventListener("click", () => {
      const prompt = el.dataset.mktPrompt || "";
      const slug = el.dataset.mktSlug || null;
      if (prompt) saveStarterIdea(prompt, slug);
    });
  });
</script>
