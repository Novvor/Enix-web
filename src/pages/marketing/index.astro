---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { primaryMarketingServices, brandComplementaryService } from "@/content/marketing";
import { siteConfig } from "@/content/site";
import { buildBreadcrumbSchema } from "@/lib/seo/schema";

const jsonLdNodes = [
  buildBreadcrumbSchema([
    { name: "Portada", path: "/" },
    { name: "Marketing", path: "/marketing/" }
  ])
];
---

<MarketingLayout
  title="Marketing digital y marca — ENIX Studio"
  description="Estrategia digital, publicidad en Google Ads y Meta Ads, SEO y presencia local, contenido, email comercial, analítica y diseño de marca conectados a tu experiencia digital."
  jsonLdNodes={jsonLdNodes}
>
  <section class="section">
    <div class="container">
      <div class="mkt-page-head">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Marketing digital y marca</span>
        </div>
        <h1 class="heading-xl">Atrae clientes reales con estrategia, marca y campañas conectadas a tu web</h1>
        <p class="lead">
          Unimos marketing y desarrollo en el mismo equipo para que cada visita convierta.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:0.7rem; margin-top:0.25rem;">
          <a href="/create-project/?category=marketing" class="btn btn-primary">
            Definir mi plan de marketing →
          </a>
          <a href="/contact/" class="btn btn-secondary">Hablar con el equipo</a>
        </div>
      </div>

      <!-- Compact 3-pillar trust strip -->
      <div class="mkt-trust-strip">
        <div class="mkt-trust-item">
          <strong>Trabajo puntual o mensual</strong>
          <span>Empieza con un lanzamiento acotado o acompañamiento periódico.</span>
        </div>
        <div class="mkt-trust-item">
          <strong>Pauta separada de honorarios</strong>
          <span>La inversión en Google/Meta siempre va aparte de la gestión.</span>
        </div>
        <div class="mkt-trust-item">
          <strong>Métricas honestas</strong>
          <span>Acordamos indicadores claros, sin promesas mágicas de ventas.</span>
        </div>
      </div>

      <!-- 6 Services in clean 3-column scannable grid -->
      <div class="mkt-section-block">
        <h2 class="heading-lg" style="margin-block-end: 1.25rem;">Servicios de marketing digital</h2>
        <div class="mkt-catalog-grid">
          {primaryMarketingServices.map((srv, idx) => (
            <article class="mkt-service-card">
              <div class="mkt-card-top">
                <span class="mkt-card-num">0{idx + 1}</span>
                <span class="mkt-card-tag">Marketing</span>
              </div>
              <h3 class="heading-md">{srv.name}</h3>
              <p class="mkt-service-desc">{srv.shortDescription}</p>
              <ul class="mkt-mini-list">
                {srv.deliverables.slice(0, 2).map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
              <div class="mkt-service-actions">
                <a href={`/marketing/${srv.slug}/`} class="mkt-detail-link">Ver alcance →</a>
                <a
                  href={`/create-project/?category=${srv.slug}`}
                  class="btn btn-primary btn-sm"
                  data-mkt-prompt={srv.starterPrompt}
                  data-mkt-slug={srv.slug}
                >
                  Definir
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Branding complementary panel -->
      <div class="mkt-section-block">
        <article class="brand-full-panel">
          <div style="display:flex; flex-direction:column; gap:0.7rem; align-items:flex-start;">
            <span class="eyebrow" style="background: var(--bg-surface);">
              <span class="eyebrow-dot" aria-hidden="true"></span>
              <span>Servicio complementario · Marca</span>
            </span>
            <h2 class="heading-lg">{brandComplementaryService.name}</h2>
            <p class="lead" style="font-size: var(--text-sm);">
              {brandComplementaryService.shortDescription}
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.65rem; margin-top:0.25rem;">
              <a href="/marketing/brand-design/" class="btn btn-secondary btn-sm">Ver alcance de marca →</a>
              <a
                href="/create-project/?category=brand-design"
                class="btn btn-primary btn-sm"
                data-mkt-prompt={brandComplementaryService.starterPrompt}
                data-mkt-slug="brand-design"
              >
                Definir marca
              </a>
            </div>
          </div>

          <div class="brand-diff-grid">
            <div class="brand-diff-card">
              <h3>Identidad completa</h3>
              <p>Sistema visual, paleta, tipografía, logo y guía para web y redes.</p>
            </div>
            <div class="brand-diff-card">
              <h3>Piezas para campaña</h3>
              <p>Anuncios, banners y soportes puntuales sobre tu marca actual.</p>
            </div>
          </div>
        </article>
      </div>

      <div class="mkt-section-block tech-bridge-panel">
        <div>
          <h2 class="heading-md">Conectado con desarrollo a medida</h2>
          <p style="font-size: var(--text-sm); color: var(--ink-secondary); margin: 0.3rem 0 0;">
            Páginas de captación, agenda de reservas y automatizaciones en el mismo equipo.
          </p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          <a href="/solutions/websites/" class="btn btn-secondary btn-sm">Sitios web</a>
          <a href="/solutions/automations/" class="btn btn-secondary btn-sm">Automatizaciones</a>
          <a href="/solutions/management-systems/" class="btn btn-secondary btn-sm">Sistemas</a>
        </div>
      </div>

      <p style="font-size: var(--text-xs); color: var(--ink-muted); margin-block-start: 1.25rem;">
        {siteConfig.responsibilityStatement}
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .mkt-page-head {
    max-inline-size: 760px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-block-end: 2rem;
  }

  .mkt-trust-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    padding: 1.15rem 1.25rem;
    border-radius: 20px;
    background: var(--surface-dark);
    color: var(--ink-on-dark);
  }

  .mkt-trust-item strong {
    display: block;
    font-size: 0.86rem;
    color: var(--glow-peach);
    margin-block-end: 0.2rem;
  }

  .mkt-trust-item span {
    display: block;
    font-size: 0.76rem;
    color: var(--ink-on-dark-muted);
    line-height: 1.45;
  }

  .mkt-section-block {
    margin-block-start: 2.5rem;
  }

  .mkt-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .mkt-service-card {
    padding: 1.4rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .mkt-service-card:hover {
    border-color: rgba(243, 75, 33, 0.36);
  }

  .mkt-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mkt-card-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink-muted);
  }

  .mkt-card-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-warm-tint);
    color: var(--accent-deep);
  }

  .mkt-service-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .mkt-mini-list {
    padding-inline-start: 1.05rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    font-size: var(--text-xs);
    color: var(--ink-primary);
    line-height: 1.45;
  }

  .mkt-service-actions {
    margin-block-start: auto;
    padding-block-start: 0.7rem;
    border-top: 1px solid rgba(48, 27, 60, 0.07);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .mkt-detail-link {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-deep);
  }

  .mkt-detail-link:hover {
    text-decoration: underline;
  }

  .brand-full-panel {
    padding: clamp(1.35rem, 3vw, 2.15rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border: 1px solid rgba(243, 75, 33, 0.2);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    align-items: center;
  }

  .brand-diff-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .brand-diff-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .brand-diff-card h3 {
    font-size: 0.92rem;
    margin: 0 0 0.25rem;
  }

  .brand-diff-card p {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .tech-bridge-panel {
    padding: 1.35rem 1.65rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .mkt-catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mkt-trust-strip,
    .brand-full-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .mkt-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { saveStarterIdea } from "@/lib/project/storage";

  document.querySelectorAll<HTMLAnchorElement>("[data-mkt-prompt]").forEach((el) => {
    el.addEventListener("click", () => {
      const prompt = el.dataset.mktPrompt || "";
      const slug = el.dataset.mktSlug || null;
      if (prompt) saveStarterIdea(prompt, slug);
    });
  });
</script>
