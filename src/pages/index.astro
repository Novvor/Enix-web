---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import HeroSection from "@/components/marketing/HeroSection.astro";
import RotatingServices from "@/components/marketing/RotatingServices.astro";
import ProblemsSolved from "@/components/marketing/ProblemsSolved.astro";
import InteractiveDemos from "@/components/marketing/InteractiveDemos";
import FaqAccordion from "@/components/marketing/FaqAccordion.astro";
import { homeFaqs, processStages, siteConfig } from "@/content/site";

// Keep only the 4 highest-intent buyer FAQs on Home (zero wall of text)
const compactHomeFaqs = homeFaqs.filter((item) =>
  ["tipos-proyecto", "inversion-publicitaria", "propuesta-inversion", "despues-de-definir"].includes(
    item.id
  )
);
---

<MarketingLayout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
>
  <!-- 1. Hero con mascota protagonista y asesor conversacional inline -->
  <HeroSection />

  <!-- 2. Lo que tienes en mente puede tomar muchas formas (Catálogo rotativo de 13 servicios) -->
  <RotatingServices />

  <!-- 3. Problemas cotidianos -> Solución concreta (escaneo en 3 segundos) -->
  <ProblemsSolved />

  <!-- 4. Prueba real: Demos interactivas (Sección oscura) -->
  <section class="section section-dark">
    <div class="container">
      <div class="dark-section-head">
        <div class="eyebrow eyebrow-dark">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Demostraciones interactivas · Datos de ejemplo</span>
        </div>
        <h2 class="heading-lg">Mira lo que podríamos construir</h2>
        <p class="lead">
          Tres recorridos reales para probar cómo diseñamos experiencia y operación.
        </p>
      </div>

      <InteractiveDemos client:visible compact={true} darkSurface={true} />
    </div>
  </section>

  <!-- 5. Proceso compacto en 4 pasos visuales (detalle completo en /how-we-work/) -->
  <section class="section process-section">
    <div class="container">
      <div class="process-header-row">
        <div class="section-intro-tight">
          <div class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            <span>Método claro</span>
          </div>
          <h2 class="heading-lg">Cómo pasamos de tu idea a resultados</h2>
        </div>
        <a href="/how-we-work/" class="btn btn-secondary btn-sm">
          Ver detalle de entregables →
        </a>
      </div>

      <ol class="process-grid">
        {processStages.map((stage) => (
          <li class="process-card">
            <div class="process-card-top">
              <span class="process-icon" aria-hidden="true">
                {stage.number === "01" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m21 21-4.3-4.3" />
                  </svg>
                )}
                {stage.number === "02" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="3" />
                    <path d="M3 9h18M9 21V9" />
                  </svg>
                )}
                {stage.number === "03" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {stage.number === "04" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <path d="m19 9-5 5-4-4-3 3" />
                  </svg>
                )}
              </span>
              <span class="process-num">{stage.number}</span>
            </div>
            <h3 class="heading-md">{stage.name}</h3>
            <p class="process-summary">{stage.summary}</p>
          </li>
        ))}
      </ol>

      <div class="audience-pills-strip">
        <span class="audience-strip-label">Trabajamos con:</span>
        <a href="/for/entrepreneurs/" class="audience-pill-link">Emprendedores y negocios →</a>
        <a href="/for/businesses/" class="audience-pill-link">Empresas y operaciones →</a>
        <a href="/studio/" class="audience-pill-link">Conocer el equipo →</a>
      </div>
    </div>
  </section>

  <!-- 6. 4 dudas clave antes de cotizar -->
  <FaqAccordion items={compactHomeFaqs} />

  <!-- 7. Cierre oscuro directo con respaldo humano -->
  <section class="section section-dark closing-section">
    <div class="container closing-inner">
      <div class="eyebrow eyebrow-dark">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Diseño · Ingeniería · Marketing · {siteConfig.legalParent}</span>
      </div>
      <h2 class="heading-xl">¿Listo para darle forma a tu proyecto?</h2>
      <p class="lead">
        Ordena tu idea en minutos o conversa directo con el equipo en {siteConfig.contactEmail}.
      </p>
      <div class="closing-actions">
        <a href="/create-project/" class="btn btn-light">
          Definir mi proyecto →
        </a>
        <a href="/contact/" class="btn btn-ghost-dark">
          Hablar con el equipo
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .dark-section-head {
    max-inline-size: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }

  .process-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-block-end: 1.75rem;
  }

  .section-intro-tight {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .process-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .process-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .process-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .process-icon {
    inline-size: 40px;
    block-size: 40px;
    border-radius: 12px;
    background: linear-gradient(145deg, #fff1e8 0%, #f5ecf7 100%);
    border: 1px solid rgba(243, 75, 33, 0.18);
    color: var(--accent-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .process-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-deep);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-warm-tint);
  }

  .process-summary {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .audience-pills-strip {
    margin-block-start: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .audience-strip-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .audience-pill-link {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-primary);
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .audience-pill-link:hover {
    border-color: var(--accent-orange);
    color: var(--accent-deep);
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-inline-size: 700px;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
