---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import EditorialHero from "@/components/home/EditorialHero.astro";
import SelectedWork from "@/components/home/SelectedWork.astro";
import PositioningStatement from "@/components/home/PositioningStatement.astro";
import EditorialCapabilities from "@/components/home/EditorialCapabilities.astro";
import SelectedEngagements from "@/components/home/SelectedEngagements.astro";
import NovvorMuscle from "@/components/home/NovvorMuscle.astro";
import StudioManifesto from "@/components/home/StudioManifesto.astro";
import HomeCtaBanner from "@/components/home/HomeCtaBanner.astro";
import { site } from "@/data/site";


const studioFaqs: [string, string][] = [
  [
    "¿Qué tipo de proyectos acepta ENIX Studio?",
    "Trabajamos con marcas consolidadas, empresas en fase de expansión, clínicas de especialidad, hospitality, firmas industriales y compañías B2B que requieren estrategia de posicionamiento, dirección de arte de alto nivel y desarrollo de plataformas digitales complejas.",
  ],
  [
    "¿Cuál es la diferencia entre ENIX Studio y WebBase?",
    "WebBase es nuestra solución estandarizada y ágil para pymes y emprendimientos que buscan una web rápida y accesible. ENIX Studio opera como un estudio boutique de alta gama, con proyectos 100% a medida, consultoría estratégica directa y un cupo deliberadamente limitado de clientes por trimestre.",
  ],
  [
    "¿Cómo funciona el respaldo tecnológico de NOVVOR?",
    "Cuando un proyecto creativo demanda arquitectura cloud masiva, automatización de procesos comerciales, ingeniería de datos o aplicaciones avanzadas de inteligencia artificial, el equipo de ingeniería de NOVVOR interviene directamente en la infraestructura y desarrollo técnico.",
  ],
  [
    "¿Cómo iniciamos un proyecto?",
    "A través del formulario de calificación 'Start a Project'. Evaluamos el alcance, objetivos comerciales y encaje mutuo para agendar una sesión estratégica preliminar.",
  ],
];
---

<BaseLayout
  title="ENIX STUDIO — Digital Studio · Strategy, Design & Technology"
  description="Consultoría estratégica, dirección de arte e ingeniería aplicada para empresas que compiten en ligas mayores. Operaciones globales respaldadas por NOVVOR."
  canonical={site.url}
  faqItems={studioFaqs}
>

  <Header currentPath={Astro.url.pathname} client:load />

  <main class="min-h-screen">
    {/* 01 — Editorial Hero */}
    <EditorialHero />

    {/* 02 — Selected Work */}
    <SelectedWork />

    {/* 03 — Positioning Statement */}
    <PositioningStatement />

    {/* 04 — Editorial Capabilities Grid */}
    <EditorialCapabilities />

    {/* 05 — Selected Engagements Process */}
    <SelectedEngagements />

    {/* 06 — Technological Muscle: NOVVOR */}
    <NovvorMuscle />

    {/* 08 — Studio Manifesto */}
    <StudioManifesto />

    {/* 09 — Executive Invitation Banner (Links to dedicated /contacto/ page) */}
    <HomeCtaBanner />
  </main>


  <Footer />
</BaseLayout>
