---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import HeroSection from "@/components/marketing/HeroSection.astro";
import SolutionsShowcase from "@/components/marketing/SolutionsShowcase.astro";
import MarketingShowcase from "@/components/marketing/MarketingShowcase.astro";
import InteractiveDemos from "@/components/marketing/InteractiveDemos";
import BriefBridgeSection from "@/components/marketing/BriefBridgeSection.astro";
import FaqAccordion from "@/components/marketing/FaqAccordion.astro";
import { audiencePaths, homeFaqs, processStages, siteConfig } from "@/content/site";
---

<MarketingLayout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
>
  <!-- 1. Hero con entrada al proyecto -->
  <HeroSection />

  <!-- 2. Lo que tienes en mente puede tomar muchas formas -->
  <SolutionsShowcase />

  <!-- 3. Mira lo que podríamos construir (Sección oscura — adelantada antes de marketing para mostrar prueba interactiva antes, ENX-09) -->
  <section class="section section-dark">
    <div class="container">
      <div class="dark-section-head">
        <div class="eyebrow eyebrow-dark">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Demostraciones interactivas · Datos de ejemplo</span>
        </div>
        <h2 class="heading-lg">Mira lo que podríamos construir</h2>
        <p class="lead">
          Prueba tres recorridos funcionales con datos de ejemplo para ver cómo trabajamos experiencia, claridad operativa y reglas de negocio.
        </p>
      </div>

      <InteractiveDemos client:visible compact={true} darkSurface={true} />
    </div>
  </section>

  <!-- 4. Marketing digital y marca -->
  <MarketingShowcase />

  <!-- 4. De tu idea a un alcance claro -->
  <BriefBridgeSection />

  <!-- 5. Para lo que estás empezando. Para lo que necesitas transformar -->
  <section class="section audience-section">
    <div class="container">
      <div class="section-intro-wide">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Dos contextos, el mismo estándar</span>
        </div>
        <h2 class="heading-lg">Para lo que estás empezando.<br />Para lo que necesitas transformar.</h2>
        <p class="lead">
          El tamaño de tu empresa no define la calidad de tu proyecto. Adaptamos alcance, ritmo y acompañamiento a tu realidad actual.
        </p>
      </div>

      <div class="audience-grid">
        {audiencePaths.map((path) => (
          <article class="audience-card">
            <span class="audience-eyebrow">{path.eyebrow}</span>
            <h3 class="heading-md">{path.headline}</h3>
            <p class="audience-summary">{path.summary}</p>
            <ul class="audience-list">
              {path.examples.slice(0, 3).map((ex) => (
                <li>{ex}</li>
              ))}
            </ul>
            <div class="audience-card-footer">
              <a href={`/for/${path.slug}/`} class="btn btn-secondary btn-sm">
                Ver cómo acompañamos →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Así trabajamos contigo -->
  <section class="section process-section">
    <div class="container">
      <div class="section-intro-wide">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Proceso claro y sin cajas negras</span>
        </div>
        <h2 class="heading-lg">Así trabajamos contigo</h2>
        <p class="lead">
          Cuatro etapas con entregables visibles para que siempre sepas qué estamos construyendo y qué decisión sigue.
        </p>
      </div>

      <ol class="process-grid">
        {processStages.map((stage) => (
          <li class="process-card">
            <span class="process-num">{stage.number}</span>
            <h3 class="heading-md">{stage.name}</h3>
            <p class="process-summary">{stage.summary}</p>
            <div class="process-deliverable">
              <span>Entregable:</span>
              <strong>{stage.deliverable}</strong>
            </div>
          </li>
        ))}
      </ol>

      <div style="margin-block-start: 1.75rem;">
        <a href="/how-we-work/" class="btn btn-secondary">
          Ver detalle de etapas y entregables →
        </a>
      </div>
    </div>
  </section>

  <!-- 7. Un proyecto claro desde el primer paso (ENX-06) -->
  <section class="section evidence-section">
    <div class="container">
      <div class="evidence-panel">
        <div class="evidence-copy">
          <div class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            <span>Forma de trabajar</span>
          </div>
          <h2 class="heading-lg">Un proyecto claro desde el primer paso.</h2>
          <p class="lead">
            Definimos contigo el alcance, los entregables y la forma de trabajar. Durante el proyecto, revisamos avances y acordamos las decisiones que siguen.
          </p>
          <div class="evidence-actions">
            <a href="/create-project/" class="btn btn-primary">Definir mi proyecto →</a>
            <a href="/studio/" class="btn btn-secondary">Conocer ENIX Studio</a>
          </div>
        </div>

        <div class="evidence-pillars">
          <div class="evidence-pillar">
            <strong>Alcance y entregables visibles</strong>
            <p>Tu ficha distingue lo confirmado de las sugerencias opcionales para cotizar y priorizar sin sorpresas.</p>
          </div>
          <div class="evidence-pillar">
            <strong>Dirección de proyectos directa</strong>
            <p>Interlocución clara desde la evaluación inicial hasta la publicación, con respaldo de {siteConfig.legalParent} en {siteConfig.contactEmail}.</p>
          </div>
          <div class="evidence-pillar">
            <strong>Base propia y documentada</strong>
            <p>Tu empresa mantiene sus dominios, cuentas y código limpio para operar o escalar en futuras etapas.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Preguntas frecuentes -->
  <FaqAccordion items={homeFaqs} />

  <!-- 9. Cierre oscuro -->
  <section class="section section-dark closing-section">
    <div class="container closing-inner">
      <h2 class="heading-xl">¿Listo para darle forma a tu proyecto?</h2>
      <p class="lead">
        Empieza describiendo tu idea en el asistente y llévate una ficha clara y editable, o conversa directamente con el equipo.
      </p>
      <div class="closing-actions">
        <a href="/create-project/" class="btn btn-light">
          Definir mi proyecto →
        </a>
        <a href="/contact/" class="btn btn-ghost-dark">
          Hablar con el equipo
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .dark-section-head {
    max-inline-size: 680px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-block-end: 2.25rem;
  }

  .section-intro-wide {
    max-inline-size: 720px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-block-end: 2.25rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .audience-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  .audience-summary {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.6;
  }

  .audience-list {
    padding-inline-start: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink-primary);
  }

  .audience-card-footer {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .process-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .process-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .process-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-deep);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-warm-tint);
    align-self: flex-start;
  }

  .process-summary {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .process-deliverable {
    margin-block-start: auto;
    padding-block-start: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--text-xs);
  }

  .process-deliverable span {
    color: var(--ink-muted);
    font-weight: 600;
  }

  .evidence-panel {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(155deg, #fff5ef 0%, #f5eef6 100%);
    border: 1px solid rgba(243, 75, 33, 0.16);
    align-items: center;
  }

  .evidence-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .evidence-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .evidence-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .evidence-pillar {
    padding: 1.05rem 1.2rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .evidence-pillar strong {
    display: block;
    font-size: var(--text-sm);
    margin-block-end: 0.25rem;
  }

  .evidence-pillar p {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    max-inline-size: 760px;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .audience-grid,
    .evidence-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
