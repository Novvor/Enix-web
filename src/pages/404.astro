---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Página no encontrada — ENIX Studio"
  description="No encontramos la página que buscabas. Explora las soluciones o inicia tu ficha de proyecto."
  noindex={true}
  omitCanonical={true}
>
  <section class="section">
    <div class="container" style="max-inline-size: 680px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.1rem;">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Error 404</span>
      </div>
      <h1 class="heading-xl">Esta página no está disponible</h1>
      <p class="lead">
        Puede que el enlace haya cambiado o que la dirección tenga un error. Desde aquí puedes volver a la portada o empezar a definir tu proyecto.
      </p>
      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:0.75rem; margin-top:0.5rem;">
        <a href="/" class="btn btn-primary">Volver a la portada</a>
        <a href="/create-project/" class="btn btn-secondary">Definir mi proyecto</a>
        <a href="/solutions/" class="btn btn-secondary">Ver soluciones</a>
      </div>
    </div>
  </section>
</MarketingLayout>
