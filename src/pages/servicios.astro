---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

const canonical = `${site.url}/servicios/`;

const capabilitiesDetailed = [
  {
    num: "01",
    name: "Consultoría Estratégica & Modelo Comercial",
    tagline: "Strategic Advisory & Market Positioning",
    desc: "Diagnosticamos la brecha entre el valor real de su empresa y la forma en que el mercado lo percibe. Reestructuramos la narrativa comercial, diseñamos ofertas para cuentas corporativas de alto ticket y definimos la arquitectura para licitaciones privadas e internacionales.",
    deliverables: [
      "Diagnóstico Integral de Percepción & Brecha Comercial",
      "Estructuración de Propuestas de Valor Enterprise",
      "Estrategia de Diferenciación para Licitaciones y Negociación",
      "Gobernanza de Marca y Lineamientos Comerciales para Directorios",
    ],
  },
  {
    num: "02",
    name: "Dirección de Arte & Percepción de Marca",
    tagline: "Brand Identity & Perception Engineering",
    desc: "No hacemos logos decorativos. Creamos identidades visuales editoriales de estándar global que transmiten solidez patrimonial, sofisticación estética y autoridad indiscutible ante inversionistas, clientes institucionales y talento calificado.",
    deliverables: [
      "Estrategia e Identidad Visual de Marca",
      "Sistemas de Diseño Editorial de Alta Costura",
      "Dirección de Fotografía, Video y Contenido Institucional",
      "Manuales de Aplicación y Directrices Tipográficas",
    ],
  },
  {
    num: "03",
    name: "Plataformas Digitales & Software a Medida",
    tagline: "Enterprise Platforms & Digital Ecosystems",
    desc: "Desarrollo de software a medida con foco en velocidad extrema, accesibilidad y ciberseguridad. Desde showrooms digitales interactivos y modelado 3D para real estate, hasta portales corporativos multi-región y plataformas transaccionales B2B.",
    deliverables: [
      "Portales Digitales Institucionales de Alta Velocidad (Astro/React)",
      "Showrooms Inmersivos & Visualizadores 3D en el Navegador",
      "Ecosistemas Digitales de Admisión y Registro de Clientes",
      "Auditoría Técnica de Ciberseguridad y Cumplimiento Normativo",
    ],
  },
  {
    num: "04",
    name: "Diseño Industrial & Hardware (Powered by NOVVOR)",
    tagline: "Industrial Design, Hardware & Machine Interfaces (HMI)",
    desc: "El punto de convergencia donde el diseño digital se encuentra con la ingeniería física. En alianza directa con NOVVOR, abordamos diseño de productos tangibles, carcasas para equipamiento de faena, interfaces de usuario para operadores de maquinaria y telemetría de sensores IoT.",
    deliverables: [
      "Diseño Industrial & Modelado CAD de Producto Físico",
      "Interfaces de Control de Maquinaria (HMI) para Faenas Mineras e Industriales",
      "Integración de Sensores IoT y Telemetría en Tiempo Real",
      "Infraestructura Cloud Crítica & Modelos de IA Aplicada",
    ],
  },
];

const capabilitiesPageSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Capabilities & Advisory Scope | ENIX STUDIO",
  url: canonical,
  description:
    "Capacidades de consultoría estratégica, dirección de arte, desarrollo de plataformas digitales e ingeniería industrial desarrollada con NOVVOR.",
  provider: {
    "@type": "Organization",
    name: site.name,
  },
};
---

<BaseLayout
  title="Capabilities & Advisory Scope | ENIX STUDIO"
  description="Consultoría estratégica, dirección de arte e ingeniería de software e industrial para organizaciones de alta exigencia."
  canonical={canonical}
  breadcrumbs={[{ name: "Inicio", url: site.url }, { name: "Capabilities", url: canonical }]}
>
  <Header currentPath={Astro.url.pathname} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(capabilitiesPageSchema)} />

  <main class="min-h-screen bg-[#0A0A0A] text-[#F7F7F4] pt-28 md:pt-36">
    {/* Page Header */}
    <section class="px-4 md:px-8 pb-16 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-400 block mb-4">
          Core Capabilities · Strategic Scope
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight max-w-5xl">
          Consultoría estratégica, diseño e ingeniería aplicada.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          Diseñamos soluciones integrales para organizaciones donde la reputación, el rendimiento técnico y la continuidad operativa son activos críticos de negocio.
        </p>
      </div>
    </section>

    {/* Pillars Grid */}
    <section class="py-24 md:py-32 px-4 md:px-8">
      <div class="max-w-7xl mx-auto space-y-24 md:space-y-32">
        {capabilitiesDetailed.map((cap) => (
          <article class="p-8 md:p-14 rounded-3xl border border-white/10 bg-neutral-900/40 grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start">
            <div class="lg:col-span-4 space-y-4">
              <span class="font-mono text-sm text-neutral-500 block">
                {cap.num} / 04
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                {cap.name}
              </h2>
              <p class="text-xs font-mono tracking-wider uppercase text-neutral-400">
                {cap.tagline}
              </p>
            </div>

            <div class="lg:col-span-8 space-y-8">
              <p class="text-base md:text-lg text-neutral-300 font-light leading-relaxed">
                {cap.desc}
              </p>

              <div class="pt-6 border-t border-white/10">
                <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block mb-4">
                  Entregables & Alcance Típico
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {cap.deliverables.map((item) => (
                    <div class="p-4 rounded-xl border border-white/5 bg-white/[0.02] flex items-start gap-2 text-xs text-neutral-300">
                      <span class="text-red-500 font-bold">›</span>
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Engagement Models */}
    <section class="py-24 px-4 md:px-8 border-t border-white/10 bg-[#070707]">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block mb-3">
            Engagement Formats
          </span>
          <h3 class="text-3xl sm:text-4xl font-black text-white">
            Modelos de Colaboración
          </h3>
          <p class="text-sm text-neutral-400 mt-2 font-light">
            Estructuramos compromisos de trabajo según la madurez y necesidad de cada organización.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 rounded-2xl border border-white/10 bg-white/[0.02] space-y-4">
            <span class="font-mono text-xs text-neutral-400 uppercase tracking-widest block">01 / Bespoke Transformation</span>
            <h4 class="text-xl font-bold text-white">Intervención de Alcance Cerrado</h4>
            <p class="text-xs text-neutral-300 leading-relaxed font-light">
              Proyectos de 8 a 16 semanas enfocados en resolver un desafío de negocio específico: reposicionamiento de marca corporativa, lanzamiento de un portal o showroom digital, o rediseño de interfaz industrial de un producto.
            </p>
          </div>

          <div class="p-8 rounded-2xl border border-white/10 bg-white/[0.02] space-y-4">
            <span class="font-mono text-xs text-neutral-400 uppercase tracking-widest block">02 / Advisory & Directorship</span>
            <h4 class="text-xl font-bold text-white">Acompañamiento Estratégico Continuo</h4>
            <p class="text-xs text-neutral-300 leading-relaxed font-light">
              Participación directa a nivel de directorio y gerencia general para supervisar la evolución del ecosistema digital, gobierno de datos, optimización y nuevas implementaciones de ingeniería con NOVVOR.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Executive CTA to Start a Project */}
    <section class="py-24 px-4 md:px-8 border-t border-white/10 bg-[#050505] text-center">
      <div class="max-w-4xl mx-auto space-y-6">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Initiate Engagement
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
          Inicie una conversación estratégica con nuestra dirección.
        </h2>
        <p class="text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
          Cada proyecto es evaluado bajo acuerdos estrictos de confidencialidad (NDA).
        </p>
        <div class="pt-4">
          <a href="/contacto/" class="btn-editorial bg-white text-black font-bold text-xs uppercase tracking-wider px-8 py-3.5 hover:bg-neutral-200">
            Start a Project ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
