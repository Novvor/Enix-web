---
import fs from "node:fs";
import path from "node:path";
import "@fontsource-variable/plus-jakarta-sans";
import "@/styles/tokens.css";
import "@/styles/global.css";
import SeoHead from "@/components/seo/SeoHead.astro";
import SiteHeader from "@/components/navigation/SiteHeader.astro";
import SiteFooter from "@/components/navigation/SiteFooter.astro";
import ContextualAssistant from "@/components/assistant/ContextualAssistant";
import { siteConfig } from "@/content/site";

const hasRiveAsset =
  String(import.meta.env.PUBLIC_ENABLE_RIVE_MASCOT || "").toLowerCase() === "true" &&
  fs.existsSync(path.join(process.cwd(), "public/brand/enix-mascot-rive.riv"));

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  omitCanonical?: boolean;
  robots?: string;
  jsonLdNodes?: Record<string, unknown>[];
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  noindex = false,
  omitCanonical = false,
  robots,
  jsonLdNodes = []
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      noindex={noindex}
      omitCanonical={omitCanonical}
      robots={robots}
      jsonLdNodes={jsonLdNodes}
    />
  </head>
  <body>
    <a href="#contenido" class="skip-link visually-hidden">Saltar al contenido principal</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="contenido">
      <slot />
    </main>
    <ContextualAssistant client:idle currentPath={Astro.url.pathname} hasRiveAsset={hasRiveAsset} />
    <SiteFooter />
  </body>
</html>
