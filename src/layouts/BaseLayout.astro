---
import "../styles/global.css";
import { site } from "@/data/site";

import CookieConsent from "@/components/CookieConsent";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import ScrollRevealInit from "@/components/ScrollRevealInit.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: { name: string; url: string }[];
  faqItems?: [string, string][];
  extraSchemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  canonical = site.url,
  ogImage = `${site.url}/og-enix-studio.svg`,
  breadcrumbs = [{ name: "Inicio", url: site.url }],
  faqItems = [],
  extraSchemas = [],
  noindex = false,
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  name: site.name,
  alternateName: ["ENIX", "ENIX STUDIO", "Enix Studio Global"],
  url: site.url,
  email: site.email,
  description: site.description,
  slogan: "Consultoría estratégica, dirección de arte e ingeniería aplicada para empresas que compiten en ligas mayores.",
  priceRange: "$$$$",
  brand: { "@type": "Brand", name: "ENIX STUDIO" },
  sameAs: [site.linkedin],
  areaServed: ["Chile", "Latinoamérica", "United States", "Europe", "Global"],
  knowsAbout: [
    "Consultoría Estratégica",
    "Desarrollo Web Corporativo",
    "Dirección de Arte e Identidad de Marca",
    "Diseño Industrial y Maquinaria HMI",
    "Arquitectura de Software y Ciberseguridad",
    "Inteligencia Artificial Aplicada a Negocios",
    "Posicionamiento SEO de Autoridad",
    "Bespoke Digital Platforms",
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      item: {
        "@type": "Service",
        name: "Consultoría Estratégica & Modelo Comercial",
        description: "Reestructuración de narrativa comercial B2B, posicionamiento de autoridad y arquitectura para licitaciones privadas de alto valor.",
        provider: { "@type": "Organization", name: site.name },
      },
    },
    {
      "@type": "ListItem",
      position: 2,
      item: {
        "@type": "Service",
        name: "Dirección de Arte & Identidad Corporativa",
        description: "Sistemas de identidad visual editorial de estándar global para fondos de inversión, clínicas y consorcios industriales.",
        provider: { "@type": "Organization", name: site.name },
      },
    },
    {
      "@type": "ListItem",
      position: 3,
      item: {
        "@type": "Service",
        name: "Plataformas Web & Software a Medida",
        description: "Desarrollo de portales digitales de alta velocidad, showrooms 3D y ecosistemas de admisión de clientes con ciberseguridad avanzada.",
        provider: { "@type": "Organization", name: site.name },
      },
    },
    {
      "@type": "ListItem",
      position: 4,
      item: {
        "@type": "Service",
        name: "Diseño Industrial & Hardware (con NOVVOR)",
        description: "Diseño de producto físico, carcasas de sensores IoT, interfaces HMI de maquinaria pesada y telemetría industrial.",
        provider: { "@type": "Organization", name: site.name },
      },
    },
  ],
};


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta name="keywords" content="consultoría digital estratégica, desarrollo web corporativo chile, diseño industrial novvor, estudio de diseño boutique, consultora tecnológica chile, software a medida empresas, branding de alto valor, digital consultancy LATAM" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0A0A0A" />

    <GoogleAnalytics />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {faqItems.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {extraSchemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <slot />
    <ScrollRevealInit />
    <CookieConsent client:idle />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
