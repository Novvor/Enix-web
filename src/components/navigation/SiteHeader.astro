<script>
  const shell = document.querySelector("[data-header-shell]");
  if (shell) {
    const triggers = Array.from(shell.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]"));
    const panels = Array.from(shell.querySelectorAll<HTMLElement>("[data-dropdown-panel]"));
    let activeId: string | null = null;
    let hoverOpened = false;
    let closeTimer: number | null = null;

    const clearCloseTimer = () => {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    };

    const closeAll = (restoreFocus = false) => {
      const prevId = activeId;
      activeId = null;
      hoverOpened = false;
      triggers.forEach((btn) => btn.setAttribute("aria-expanded", "false"));
      panels.forEach((panel) => {
        panel.hidden = true;
      });
      if (restoreFocus && prevId) {
        const trigger = triggers.find((t) => t.dataset.dropdownTrigger === prevId);
        trigger?.focus();
      }
    };

    const openPanel = (id: string, viaHover = false) => {
      clearCloseTimer();
      activeId = id;
      hoverOpened = viaHover;
      triggers.forEach((btn) => {
        btn.setAttribute("aria-expanded", String(btn.dataset.dropdownTrigger === id));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.dropdownPanel !== id;
      });
    };

    triggers.forEach((trigger) => {
      const panelId = trigger.dataset.dropdownTrigger!;
      trigger.addEventListener("click", () => {
        if (activeId === panelId && !hoverOpened) {
          closeAll(false);
        } else {
          openPanel(panelId, false);
        }
      });

      trigger.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse" || !window.matchMedia("(hover: hover)").matches) return;
        openPanel(panelId, true);
      });
    });

    shell.addEventListener("pointerenter", clearCloseTimer);
    shell.addEventListener("pointerleave", (e) => {
      const pe = e as PointerEvent;
      if (pe.pointerType !== "mouse" || !hoverOpened) return;
      closeTimer = window.setTimeout(() => closeAll(false), 180);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && activeId) {
        closeAll(true);
      }
    });

    document.addEventListener("click", (e) => {
      if (activeId && !shell.contains(e.target as Node)) {
        closeAll(false);
      }
    });

    shell.addEventListener("focusout", (e) => {
      const nextTarget = (e as FocusEvent).relatedTarget as Node | null;
      if (activeId && nextTarget && !shell.contains(nextTarget)) {
        closeAll(false);
      }
    });
  }

  // Mobile native <dialog> drawer with closedby fallback (modern-web-guidance: dialog)
  const mobileDialog = document.getElementById("mobile-nav-dialog") as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>("[data-open-mobile-nav]");
  if (mobileDialog && openBtn) {
    openBtn.addEventListener("click", () => {
      if (!mobileDialog.open) mobileDialog.showModal();
    });

    if (!("closedBy" in HTMLDialogElement.prototype)) {
      let pressedOutside = false;
      const isOutside = (e: PointerEvent) => {
        const r = mobileDialog.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      };
      mobileDialog.addEventListener("pointerdown", (e) => {
        pressedOutside = isOutside(e);
      });
      mobileDialog.addEventListener("pointerup", (e) => {
        if (pressedOutside && isOutside(e)) mobileDialog.close();
      });
    }
  }
</script>
