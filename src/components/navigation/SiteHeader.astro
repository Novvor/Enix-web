---
import { solutions } from "@/content/solutions";
import { primaryMarketingServices, brandComplementaryService } from "@/content/marketing";
import { audiencePaths } from "@/content/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const normalize = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const activePath = normalize(currentPath);
---

<header class="site-header-wrap no-print">
  <div class="site-header-shell" data-header-shell>
    <div class="site-header-bar">
      <a
        href="/"
        class="brand-link"
        aria-label="ENIX Studio — Ir a la portada"
        aria-current={activePath === "/" ? "page" : undefined}
      >
        <img
          src="/brand/enix-logo-320.webp"
          alt="ENIX"
          width="320"
          height="91"
          class="brand-logo"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="desktop-nav" aria-label="Principal">
        <ul class="nav-list">
          <li class="nav-item" data-dropdown-item>
            <button
              type="button"
              class:list={["nav-trigger", { "is-active": activePath.startsWith("/solutions/") }]}
              aria-expanded="false"
              aria-controls="megamenu-soluciones"
              data-dropdown-trigger="megamenu-soluciones"
            >
              <span>Soluciones</span>
              <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </li>

          <li class="nav-item" data-dropdown-item>
            <button
              type="button"
              class:list={["nav-trigger", { "is-active": activePath.startsWith("/marketing/") }]}
              aria-expanded="false"
              aria-controls="megamenu-marketing"
              data-dropdown-trigger="megamenu-marketing"
            >
              <span>Marketing</span>
              <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </li>

          <li class="nav-item" data-dropdown-item>
            <button
              type="button"
              class:list={["nav-trigger", { "is-active": activePath.startsWith("/for/") }]}
              aria-expanded="false"
              aria-controls="megamenu-para-quien"
              data-dropdown-trigger="megamenu-para-quien"
            >
              <span>Para quién</span>
              <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </li>

          <li class="nav-item">
            <a
              href="/demos/"
              class:list={["nav-link", { "is-active": activePath.startsWith("/demos/") }]}
              aria-current={activePath.startsWith("/demos/") ? "page" : undefined}
            >
              Demostraciones
            </a>
          </li>

          <li class="nav-item">
            <a
              href="/how-we-work/"
              class:list={["nav-link", { "is-active": activePath === "/how-we-work/" }]}
              aria-current={activePath === "/how-we-work/" ? "page" : undefined}
            >
              Cómo trabajamos
            </a>
          </li>
        </ul>
      </nav>

      <div class="header-actions">
        <a href="/create-project/" class="btn btn-primary header-cta">
          <span>Definir mi proyecto</span>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 8h9m0 0L9 4.5M12.5 8L9 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <button
          type="button"
          class="mobile-menu-btn"
          aria-label="Abrir menú de navegación"
          aria-controls="mobile-nav-dialog"
          data-open-mobile-nav
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Megamenu: Soluciones -->
    <div id="megamenu-soluciones" class="megamenu-panel" hidden data-dropdown-panel="megamenu-soluciones">
      <div class="megamenu-bridge" aria-hidden="true"></div>
      <div class="megamenu-grid">
        <div class="megamenu-solutions-col">
          <div class="megamenu-col-head">
            <span class="megamenu-kicker">Qué diseñamos y construimos</span>
            <a href="/solutions/" class="megamenu-all-link">Ver todas las soluciones →</a>
          </div>
          <ul class="megamenu-list">
            {solutions.map((item) => (
              <li>
                <a
                  href={`/solutions/${item.slug}/`}
                  class:list={["megamenu-item", { "is-current": activePath === `/solutions/${item.slug}/` }]}
                  aria-current={activePath === `/solutions/${item.slug}/` ? "page" : undefined}
                >
                  <span class="megamenu-item-icon" aria-hidden="true">
                    {item.previewType === "web" && (
                      <svg viewBox="0 0 20 20" fill="none"><rect x="2.5" y="3.5" width="15" height="13" rx="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 7.5h15" stroke="currentColor" stroke-width="1.5"/></svg>
                    )}
                    {item.previewType === "app" && (
                      <svg viewBox="0 0 20 20" fill="none"><rect x="5.5" y="2.5" width="9" height="15" rx="2.2" stroke="currentColor" stroke-width="1.5"/><path d="M9 14.5h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "system" && (
                      <svg viewBox="0 0 20 20" fill="none"><rect x="2.5" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11.5" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="11" width="15" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    )}
                    {item.previewType === "portal" && (
                      <svg viewBox="0 0 20 20" fill="none"><circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1.5"/><circle cx="13.5" cy="8" r="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 16c.5-2.6 2.2-4 4-4s3.5 1.4 4 4M11.5 16c.4-1.8 1.5-2.8 3-2.8 1.2 0 2.2.7 2.5 2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "automation" && (
                      <svg viewBox="0 0 20 20" fill="none"><circle cx="5" cy="5.5" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="15" cy="14.5" r="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 5.5h3a2 2 0 012 2v5a2 2 0 002 2h-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "ai" && (
                      <svg viewBox="0 0 20 20" fill="none"><path d="M10 3l1.6 4.4L16 9l-4.4 1.6L10 15l-1.6-4.4L4 9l4.4-1.6L10 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    )}
                  </span>
                  <span class="megamenu-item-copy">
                    <span class="megamenu-item-title">{item.name}</span>
                    <span class="megamenu-item-desc">{item.shortDescription}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <aside class="megamenu-featured">
          <div class="megamenu-featured-badge">Asistente de proyectos ENIX</div>
          <h3 class="megamenu-featured-title">De una idea a un proyecto claro</h3>
          <p class="megamenu-featured-copy">
            Responde unas preguntas simples y arma una ficha editable con lo esencial y lo que puede esperar.
          </p>
          <div class="mini-brief-preview" aria-hidden="true">
            <div class="mini-brief-row">
              <span class="mini-pill confirmed">Confirmado</span>
              <span class="mini-line">Gestión centralizada de pedidos</span>
            </div>
            <div class="mini-brief-row">
              <span class="mini-pill suggested">Sugerido</span>
              <span class="mini-line">Alertas automáticas a bodega</span>
            </div>
            <div class="mini-brief-row">
              <span class="mini-pill pending">Por definir</span>
              <span class="mini-line">Integración con facturación</span>
            </div>
          </div>
          <a href="/create-project/" class="btn btn-primary btn-sm megamenu-featured-cta">
            Empezar mi ficha →
          </a>
        </aside>
      </div>
    </div>

    <!-- Megamenu: Marketing -->
    <div id="megamenu-marketing" class="megamenu-panel" hidden data-dropdown-panel="megamenu-marketing">
      <div class="megamenu-bridge" aria-hidden="true"></div>
      <div class="megamenu-grid">
        <div class="megamenu-solutions-col">
          <div class="megamenu-col-head">
            <span class="megamenu-kicker">Marketing digital y crecimiento</span>
            <a href="/marketing/" class="megamenu-all-link">Ver página de marketing →</a>
          </div>
          <ul class="megamenu-list">
            {primaryMarketingServices.map((item) => (
              <li>
                <a
                  href={`/marketing/${item.slug}/`}
                  class:list={["megamenu-item", { "is-current": activePath === `/marketing/${item.slug}/` }]}
                  aria-current={activePath === `/marketing/${item.slug}/` ? "page" : undefined}
                >
                  <span class="megamenu-item-icon" aria-hidden="true">
                    {item.previewType === "strategy" && (
                      <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.5"/><path d="M10 3.5V5M10 15v1.5M3.5 10H5M15 10h1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "ads" && (
                      <svg viewBox="0 0 20 20" fill="none"><path d="M4 11.5v-3a1 1 0 011-1h2.5L14 4.5v11l-6.5-3H5a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M16 8c.8.6.8 3.4 0 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "seo" && (
                      <svg viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    {item.previewType === "social" && (
                      <svg viewBox="0 0 20 20" fill="none"><rect x="3" y="4" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 17l3-3h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    )}
                    {item.previewType === "email" && (
                      <svg viewBox="0 0 20 20" fill="none"><rect x="3" y="4.5" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 6l6.5 4.5L16.5 6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    )}
                    {item.previewType === "analytics" && (
                      <svg viewBox="0 0 20 20" fill="none"><path d="M4 15V9m4 6V6m4 9v-4m4 4V4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    )}
                  </span>
                  <span class="megamenu-item-copy">
                    <span class="megamenu-item-title">{item.name}</span>
                    <span class="megamenu-item-desc">{item.shortDescription}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <aside class="megamenu-featured">
          <div class="megamenu-featured-badge">Servicio complementario · Marca</div>
          <h3 class="megamenu-featured-title">{brandComplementaryService.name}</h3>
          <p class="megamenu-featured-copy">
            Identidad, mensajes y materiales gráficos. Diferenciamos siempre una identidad de marca completa del diseño de piezas puntuales para campaña.
          </p>
          <div class="mini-brief-preview" aria-hidden="true">
            <div class="mini-brief-row">
              <span class="mini-pill confirmed">Marca completa</span>
              <span class="mini-line">Sistema visual, tono y guía</span>
            </div>
            <div class="mini-brief-row">
              <span class="mini-pill suggested">Piezas campaña</span>
              <span class="mini-line">Anuncios y soportes acotados</span>
            </div>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-block-start: auto;">
            <a href="/marketing/brand-design/" class="btn btn-secondary btn-sm">
              Ver marca →
            </a>
            <a href="/create-project/?category=marketing" class="btn btn-primary btn-sm">
              Definir marketing
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- Megamenu: Para quién -->
    <div id="megamenu-para-quien" class="megamenu-panel megamenu-panel-compact" hidden data-dropdown-panel="megamenu-para-quien">
      <div class="megamenu-bridge" aria-hidden="true"></div>
      <div class="audience-dropdown-grid">
        {audiencePaths.map((path) => (
          <a
            href={`/for/${path.slug}/`}
            class:list={["audience-dropdown-card", { "is-current": activePath === `/for/${path.slug}/` }]}
            aria-current={activePath === `/for/${path.slug}/` ? "page" : undefined}
          >
            <span class="audience-dropdown-title">{path.title}</span>
            <span class="audience-dropdown-desc">{path.navDescription}</span>
            <span class="audience-dropdown-link">Explorar enfoque →</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<!-- Mobile Modal Navigation Dialog (native <dialog> per modern-web-guidance) -->
<dialog id="mobile-nav-dialog" class="mobile-drawer" closedby="any" aria-labelledby="mobile-nav-title">
  <div class="mobile-drawer-inner">
    <div class="mobile-drawer-head">
      <a href="/" class="brand-link" aria-label="ENIX Studio — Portada">
        <img src="/brand/enix-logo-320.webp" alt="ENIX" width="320" height="91" class="brand-logo brand-logo-sm" />
      </a>
      <h2 id="mobile-nav-title" class="visually-hidden">Menú de navegación</h2>
      <form method="dialog">
        <button type="submit" class="mobile-close-btn" aria-label="Cerrar menú" autofocus>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </form>
    </div>

    <nav class="mobile-drawer-nav" aria-label="Navegación móvil">
      <div class="mobile-nav-group">
        <p class="mobile-nav-heading">Soluciones</p>
        <ul class="mobile-nav-links">
          {solutions.map((item) => (
            <li>
              <a href={`/solutions/${item.slug}/`} aria-current={activePath === `/solutions/${item.slug}/` ? "page" : undefined}>
                <span>{item.name}</span>
                <small>{item.shortDescription}</small>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="mobile-nav-group">
        <p class="mobile-nav-heading">Marketing y marca</p>
        <ul class="mobile-nav-links">
          <li>
            <a href="/marketing/" aria-current={activePath === "/marketing/" ? "page" : undefined}>
              <span>Resumen de marketing digital</span>
              <small>Estrategia, campañas, SEO, contenido y medición.</small>
            </a>
          </li>
          {primaryMarketingServices.map((item) => (
            <li>
              <a href={`/marketing/${item.slug}/`} aria-current={activePath === `/marketing/${item.slug}/` ? "page" : undefined}>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/marketing/brand-design/" aria-current={activePath === "/marketing/brand-design/" ? "page" : undefined}>
              <span>Branding y diseño de marca</span>
              <small>Identidad completa o piezas para campaña.</small>
            </a>
          </li>
        </ul>
      </div>

      <div class="mobile-nav-group">
        <p class="mobile-nav-heading">Para quién</p>
        <ul class="mobile-nav-links">
          {audiencePaths.map((p) => (
            <li>
              <a href={`/for/${p.slug}/`} aria-current={activePath === `/for/${p.slug}/` ? "page" : undefined}>
                <span>{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="mobile-nav-group">
        <p class="mobile-nav-heading">Explorar</p>
        <ul class="mobile-nav-links mobile-nav-inline">
          <li><a href="/demos/">Demostraciones</a></li>
          <li><a href="/how-we-work/">Cómo trabajamos</a></li>
          <li><a href="/studio/">Estudio</a></li>
          <li><a href="/contact/">Hablar con el equipo</a></li>
        </ul>
      </div>
    </nav>

    <div class="mobile-drawer-footer">
      <a href="/create-project/" class="btn btn-primary" style="width: 100%;">
        Definir mi proyecto →
      </a>
    </div>
  </div>
</dialog>

<style>
  .site-header-wrap {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    padding-block-start: 16px;
    padding-inline: clamp(0.85rem, 2.6vw, 2.25rem);
    pointer-events: none;
  }

  .site-header-shell {
    position: relative;
    max-inline-size: var(--nav-max);
    margin-inline: auto;
    pointer-events: auto;
  }

  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-block-size: 76px;
    padding-inline: clamp(1rem, 2vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-nav);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding-block: 4px;
    border-radius: 8px;
  }

  .brand-logo {
    inline-size: clamp(92px, 8.5vw, 114px);
    block-size: auto;
  }

  .brand-logo-sm {
    inline-size: 92px;
  }

  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav-trigger,
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-block-size: 42px;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .nav-trigger:hover,
  .nav-link:hover,
  .nav-trigger[aria-expanded="true"] {
    background: var(--bg-subtle);
  }

  .nav-trigger.is-active,
  .nav-link.is-active {
    background: var(--bg-warm-tint);
    color: var(--accent-deep);
    border-color: rgba(243, 75, 33, 0.2);
  }

  .nav-chevron {
    inline-size: 15px;
    block-size: 15px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .header-cta {
    display: none;
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--ink-primary);
    cursor: pointer;
  }

  .mobile-menu-btn:hover {
    background: var(--bg-subtle);
  }

  /* Expanding Megamenu Panel */
  .megamenu-panel {
    position: absolute;
    inset-block-start: calc(100% + 10px);
    inset-inline: 0;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-megamenu);
    padding: 1.5rem;
    z-index: 50;
  }

  .megamenu-panel-compact {
    max-inline-size: 760px;
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .megamenu-panel:not([hidden]) {
      animation: megamenuIn 190ms var(--ease-out) both;
    }

    @keyframes megamenuIn {
      from {
        opacity: 0;
        translate: 0 -8px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }

  .megamenu-bridge {
    position: absolute;
    inset-block-end: 100%;
    inset-inline: 0;
    block-size: 14px;
  }

  .megamenu-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .megamenu-col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
    padding-inline: 0.5rem;
  }

  .megamenu-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .megamenu-all-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-deep);
  }

  .megamenu-all-link:hover {
    text-decoration: underline;
  }

  .megamenu-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .megamenu-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
