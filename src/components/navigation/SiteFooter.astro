---
import { siteConfig, audiencePaths } from "@/content/site";
import { solutions } from "@/content/solutions";
---

<footer class="site-footer no-print">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a href="/" class="footer-logo-badge" aria-label="ENIX Studio — Inicio">
          <img
            src="/brand/enix-logo.png"
            alt="ENIX"
            width="1578"
            height="447"
            class="footer-logo-img"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline">
          Diseño, desarrollo y marketing digital a medida para emprendedores y empresas.
        </p>
        <div class="footer-contact-meta">
          <a href={`mailto:${siteConfig.contactEmail}`} class="footer-email">
            {siteConfig.contactEmail}
          </a>
          <span class="footer-location">{siteConfig.location}</span>
        </div>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Soluciones</h3>
        <ul class="footer-links">
          {solutions.map((item) => (
            <li><a href={`/solutions/${item.slug}/`}>{item.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Marketing y marca</h3>
        <ul class="footer-links">
          <li><a href="/marketing/">Marketing digital</a></li>
          <li><a href="/marketing/digital-strategy/">Estrategia digital</a></li>
          <li><a href="/marketing/digital-advertising/">Publicidad digital</a></li>
          <li><a href="/marketing/seo-local/">SEO y presencia local</a></li>
          <li><a href="/marketing/analytics-cro/">Analítica y conversión</a></li>
          <li><a href="/marketing/brand-design/">Branding y marca</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">ENIX Studio</h3>
        <ul class="footer-links">
          {audiencePaths.map((p) => (
            <li><a href={`/for/${p.slug}/`}>{p.title}</a></li>
          ))}
          <li><a href="/demos/">Demostraciones interactivas</a></li>
          <li><a href="/how-we-work/">Cómo trabajamos</a></li>
          <li><a href="/studio/">Estudio</a></li>
          <li><a href="/contact/">Hablar con el equipo</a></li>
          <li><a href="/privacy/">Privacidad y uso de datos</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {siteConfig.brandName}. Parte de {siteConfig.legalParent}.</p>
      <p class="footer-note">
        Tu borrador se guarda en tu navegador; cuando la IA está activa, los mensajes del asistente se procesan para responderte y solo llegan al equipo de ENIX si decides enviarnos tu proyecto.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-dark);
    color: var(--ink-on-dark);
    border-top: 1px solid var(--border-on-dark);
    padding-block: clamp(3.5rem, 6vw, 5.25rem) 2.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: 360px;
  }

  .footer-logo-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.5rem 0.9rem;
    border-radius: 14px;
    background: var(--bg-canvas);
  }

  .footer-logo-img {
    inline-size: 98px;
    block-size: auto;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--ink-on-dark);
    line-height: 1.55;
  }

  .footer-statement {
    font-size: var(--text-xs);
    color: var(--ink-on-dark-muted);
    line-height: 1.5;
  }

  .footer-contact-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-block-start: 0.25rem;
  }

  .footer-email {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--glow-peach);
  }

  .footer-email:hover {
    text-decoration: underline;
  }

  .footer-location {
    font-size: var(--text-xs);
    color: var(--ink-on-dark-muted);
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--glow-peach);
    margin-block-end: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--ink-on-dark-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--ink-on-dark);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid var(--border-on-dark);
    font-size: var(--text-xs);
    color: var(--ink-on-dark-muted);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand-col {
      grid-column: 1 / -1;
      max-inline-size: none;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
