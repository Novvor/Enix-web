---
const capabilities = [
  {
    number: "01",
    name: "Consultoría Estratégica",
    subtitle: "Strategic Advisory & Market Positioning",
    desc: "Diagnosticamos y resolvemos por qué una oferta de alto valor no se traduce en contratos mayores. Estructuramos portafolios comerciales B2B, narrativa de autoridad ante directores y estrategias de diferenciación frente a competidores globales.",
    items: [
      "Diagnóstico & Reestructuración Comercial",
      "Narrativa Institucional para Licitaciones",
      "Modelado de Ofertas Enterprise",
      "Auditoría de Percepción de Mercado",
    ],
  },
  {
    number: "02",
    name: "Dirección de Arte & Marca",
    subtitle: "Brand Identity & Perception Engineering",
    desc: "Diseñamos cómo es percibida su organización ante inversionistas, clientes corporativos y socios estratégicos. Creamos sistemas de identidad visual que transmiten rigor, sofisticación y escala internacional.",
    items: [
      "Estrategia e Identidad Corporativa",
      "Sistemas de Diseño Editorial de Alta Gama",
      "Dirección Visual para Directorios & Fondos",
      "Guías de Marca & Gobierno de Comunicación",
    ],
  },
  {
    number: "03",
    name: "Plataformas & Software",
    subtitle: "Enterprise Platforms & Digital Ecosystems",
    desc: "Desarrollo a medida con estándares de arquitectura de software y ciberseguridad. Desde showrooms digitales inmersivos para real estate hasta plataformas transaccionales B2B con latencia ultrabaja.",
    items: [
      "Portales Corporativos de Alta Seguridad",
      "Showrooms Digitales & Modelado 3D",
      "Ecosistemas de Admisión & Clientes",
      "Arquitecturas Cloud Escalables",
    ],
  },
  {
    number: "04",
    name: "Diseño Industrial & Tech",
    subtitle: "Industrial Design, IoT & Applied AI (Powered by NOVVOR)",
    desc: "El punto de encuentro entre diseño digital e ingeniería física. Cuando un proyecto requiere diseño de producto tangible, carcasas de sensores, interfaces de control de maquinaria (HMI) o IA en faena, desplegamos el músculo de ingeniería de NOVVOR.",
    items: [
      "Diseño Industrial de Hardware & Sensores",
      "Interfaces HMI para Operadores & Faenas",
      "Telemetría & Flujos de Datos Industriales",
      "Agentes de IA & Automatización de Operaciones",
    ],
  },
];
---

<section id="capabilities" class="section py-28 md:py-36 px-4 md:px-8 bg-[#0A0A0A] text-[#F7F7F4] border-b border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 pb-16 border-b border-white/10">
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block mb-3">
          04 — Capabilities & Scope
        </span>
        <h2 class="text-4xl md:text-6xl font-black tracking-[-0.03em] leading-tight text-white">
          Consultoría, diseño e ingeniería aplicada.
        </h2>
      </div>
      <p class="max-w-md text-sm md:text-base text-neutral-400 leading-relaxed font-light">
        Integramos visión de negocio C-Level, diseño editorial de vanguardia y la capacidad de ingeniería industrial de NOVVOR en un único equipo directivo.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {capabilities.map((cap) => (
        <div class="group relative flex flex-col justify-between p-8 rounded-2xl border border-white/10 bg-neutral-900/50 hover:bg-neutral-900 hover:border-white/20 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
              <span class="font-mono text-sm text-neutral-500 group-hover:text-white transition">
                {cap.number}
              </span>
              <span class="text-xs font-mono tracking-widest uppercase text-neutral-400">
                Core Pillar
              </span>
            </div>

            <h3 class="text-2xl font-black tracking-tight text-white mb-2">
              {cap.name}
            </h3>

            <p class="text-[11px] font-mono tracking-wider uppercase text-neutral-400 mb-6">
              {cap.subtitle}
            </p>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-8 font-light">
              {cap.desc}
            </p>
          </div>

          <div class="pt-6 border-t border-white/10">
            <ul class="space-y-2.5">
              {cap.items.map((item) => (
                <li class="text-xs text-neutral-400 flex items-start gap-2">
                  <span class="text-red-500 font-bold">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 flex flex-col sm:flex-row items-center justify-between gap-6 p-6 rounded-2xl border border-white/10 bg-white/[0.02]">
      <div>
        <p class="text-sm font-semibold text-white">¿Su proyecto requiere una combinación de consultoría de negocio, software e ingeniería de producto?</p>
        <p class="text-xs text-neutral-400 mt-1">Estructuramos equipos multidisciplinarios dedicados exclusivamente a su iniciativa.</p>
      </div>
      <a href="#contact" class="btn-editorial btn-editorial-outline-white text-xs whitespace-nowrap">
        Evaluar Alcance ↗
      </a>
    </div>
  </div>
</section>
