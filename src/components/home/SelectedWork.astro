---
import { consultingCases } from "@/data/selectedWorkData";
---

<section id="work" class="section bg-[#0A0A0A] text-[#F7F7F4] py-28 md:py-36 px-4 md:px-8 border-b border-white/10">
  <div class="max-w-7xl mx-auto">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 pb-16 border-b border-white/10">
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block mb-3">
          02 — Consulting & Transformation Cases
        </span>
        <h2 class="text-4xl md:text-6xl font-black tracking-[-0.03em] leading-tight text-white">
          Intervenciones estratégicas de alto impacto.
        </h2>
      </div>
      <div class="flex flex-col items-start md:items-end gap-3">
        <p class="max-w-md text-sm md:text-base text-neutral-400 leading-relaxed font-light md:text-right">
          Casos reales de transformación donde resolvimos problemas complejos de negocio mediante consultoría, diseño e ingeniería NOVVOR.
        </p>
        <a href="/casos/" class="text-xs font-mono uppercase tracking-widest text-white hover:text-neutral-300 transition flex items-center gap-1.5">
          Ver todos los casos detallados <span>→</span>
        </a>
      </div>
    </div>

    {/* Case Studies */}
    <div class="mt-16 space-y-28 md:space-y-36">
      {consultingCases.map((item, idx) => {
        const isEven = idx % 2 === 0;

        return (
          <article class="p-8 md:p-12 rounded-3xl border border-white/10 bg-neutral-900/40 space-y-10 hover:border-white/20 transition-all duration-500">
            {/* Top Metadata Header */}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">
                  {item.tag}
                </span>
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                <span class="font-mono text-xs uppercase tracking-wider text-neutral-300">
                  {item.industry}
                </span>
              </div>
              <div class="font-mono text-xs px-3.5 py-1.5 rounded-full bg-white/[0.08] border border-white/15 text-white font-semibold self-start sm:self-auto">
                {item.dealValue}
              </div>
            </div>

            {/* Visual Showcase + Title Grid */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
              {/* Image Preview Container */}
              <div class={`lg:col-span-7 ${isEven ? "lg:order-1" : "lg:order-2"}`}>
                <div class="group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 bg-neutral-950 aspect-[16/10] shadow-2xl">
                  <img
                    src={item.image}
                    alt={item.title}
                    width="1600"
                    height="1000"
                    decoding="async"
                    class="w-full h-full object-cover object-center filter brightness-90 contrast-105 transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />

                  {/* Subtle Scrim & Lighting Overlay */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                  <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between text-white">
                    <div>
                      <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 block mb-1">
                        Client Focus
                      </span>
                      <p class="text-xl font-bold tracking-tight text-white drop-shadow-md">
                        {item.client}
                      </p>
                    </div>
                    <span class="font-mono text-xs px-3 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white">
                      {item.year}
                    </span>
                  </div>
                </div>
              </div>

              {/* Title & Core Summary */}
              <div class={`lg:col-span-5 ${isEven ? "lg:order-2" : "lg:order-1"} space-y-6`}>
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500 block">
                  Strategic Scope & Execution
                </span>
                <h3 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white leading-tight">
                  {item.title}
                </h3>
                <p class="text-sm text-neutral-300 leading-relaxed font-light">
                  {item.challenge}
                </p>
                <div class="p-4 rounded-xl border border-white/10 bg-white/[0.03]">
                  <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 block mb-1">
                    Impacto Económico Tangible:
                  </span>
                  <p class="text-xs font-semibold text-white">
                    {item.economicImpact}
                  </p>
                </div>
              </div>
            </div>

            {/* Consulting Scope & NOVVOR Integration Details */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-white/10">
              <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-3">
                <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 block">
                  Alcance Consultivo & Estratégico
                </span>
                <ul class="space-y-2">
                  {item.consultingScope.map((scope) => (
                    <li class="text-xs text-neutral-300 flex items-start gap-2 leading-relaxed font-light">
                      <span class="text-red-500 font-bold">›</span>
                      <span>{scope}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] space-y-3">
                <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 block">
                  Ingeniería Industrial & Alianza NOVVOR
                </span>
                <p class="text-xs text-neutral-300 leading-relaxed font-light">
                  {item.novvorIntegration}
                </p>
                <div class="pt-3 flex flex-wrap gap-2">
                  {item.deliverables.map((deliv) => (
                    <span class="text-[10px] font-mono px-2.5 py-1 rounded-full border border-white/10 bg-white/[0.04] text-neutral-300">
                      {deliv}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            {/* Bottom Actions */}
            <div class="pt-4 flex items-center justify-between">
              <a
                href="/casos/"
                class="text-xs font-mono uppercase tracking-widest text-neutral-400 hover:text-white transition flex items-center gap-1.5"
              >
                Leer documentación completa del caso <span>↗</span>
              </a>
              <a
                href="/contacto/"
                class="btn-editorial btn-editorial-outline-white text-xs"
              >
                Consultar Solución Similar ↗
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
