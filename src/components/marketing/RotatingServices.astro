---
import { UNIFIED_SERVICES } from "@/lib/project/catalog";
---

<section class="section rotating-services-section" data-rotating-services aria-labelledby="rotating-services-title">
  <div class="container">
    <div class="rs-head">
      <div class="rs-intro">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>Desarrollo, marketing y marca</span>
        </div>
        <h2 id="rotating-services-title" class="heading-lg">
          Lo que tienes en mente puede tomar muchas formas
        </h2>
        <p class="lead">
          Webs, aplicaciones, sistemas, marca y marketing digital para hacer avanzar tu negocio.
        </p>
      </div>

      <div class="rs-controls" role="group" aria-label="Controles del catálogo de servicios">
        <span class="rs-indicator" data-rs-indicator aria-live="polite">
          1–3 de {UNIFIED_SERVICES.length}
        </span>
        <div class="rs-btn-group">
          <button
            type="button"
            class="rs-ctrl-btn"
            data-rs-prev
            aria-label="Ver servicios anteriores"
          >
            ←
          </button>
          <button
            type="button"
            class="rs-ctrl-btn"
            data-rs-next
            aria-label="Ver siguientes servicios"
          >
            →
          </button>
          <button
            type="button"
            class="rs-ctrl-btn rs-pause-btn"
            data-rs-toggle
            aria-pressed="false"
            aria-label="Pausar rotación automática"
          >
            Pausar
          </button>
        </div>
      </div>
    </div>

    <div
      class="rs-track"
      data-rs-track
      role="region"
      aria-roledescription="carrusel"
      aria-label="Catálogo completo de servicios de ENIX Studio"
      tabindex="0"
    >
      {UNIFIED_SERVICES.map((item, idx) => (
        <article
          class="rs-card"
          data-rs-card
          data-rs-index={idx}
          data-service-slug={item.slug}
        >
          <div class="rs-card-top">
            <span class:list={["rs-area-badge", `is-${item.area}`]}>
              {item.areaLabel}
            </span>
            <span class="rs-card-num" aria-hidden="true">
              {String(idx + 1).padStart(2, "0")}/{UNIFIED_SERVICES.length}
            </span>
          </div>

          <div class="rs-micro-visual" aria-hidden="true">
            {item.previewType === "web" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">tunegocio.cl</span>
                <span class="rs-vis-pill is-accent">Reservar →</span>
              </div>
            )}
            {item.previewType === "ads" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-accent">Google + Meta</span>
                <span class="rs-vis-pill is-green">Medición activa</span>
              </div>
            )}
            {item.previewType === "system" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">#482 · Bodega</span>
                <span class="rs-vis-pill is-green">Despachado</span>
              </div>
            )}
            {item.previewType === "seo" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Búsqueda local</span>
                <span class="rs-vis-pill is-accent">Maps + Orgánico</span>
              </div>
            )}
            {item.previewType === "app" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Móvil + Web</span>
                <span class="rs-vis-pill is-green">Flujo V1</span>
              </div>
            )}
            {item.previewType === "strategy" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Diagnóstico</span>
                <span class="rs-vis-pill is-accent">Hoja de ruta</span>
              </div>
            )}
            {item.previewType === "portal" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Acceso B2B</span>
                <span class="rs-vis-pill is-green">Documentos</span>
              </div>
            )}
            {item.previewType === "social" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-accent">Calendario</span>
                <span class="rs-vis-pill is-ink">Piezas de marca</span>
              </div>
            )}
            {item.previewType === "automation" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Formulario</span>
                <span class="rs-vis-arrow">→</span>
                <span class="rs-vis-pill is-accent">CRM + Aviso</span>
              </div>
            )}
            {item.previewType === "email" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Cotización</span>
                <span class="rs-vis-arrow">→</span>
                <span class="rs-vis-pill is-green">Seguimiento</span>
              </div>
            )}
            {item.previewType === "ai" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Fuentes propias</span>
                <span class="rs-vis-pill is-green">Control humano</span>
              </div>
            )}
            {item.previewType === "analytics" && (
              <div class="rs-vis-row">
                <span class="rs-vis-pill is-ink">Eventos clave</span>
                <span class="rs-vis-pill is-accent">Conversión</span>
              </div>
            )}
            {item.previewType === "brand" && (
              <div class="rs-vis-row">
                <span class="rs-vis-swatch" style="background:#301B3C"></span>
                <span class="rs-vis-swatch" style="background:#F34B21"></span>
                <span class="rs-vis-swatch" style="background:#FF9B65"></span>
                <span class="rs-vis-pill is-ink">Sistema visual</span>
              </div>
            )}
          </div>

          <div class="rs-card-body">
            <h3 class="heading-md">{item.name}</h3>
            <p class="rs-card-desc">{item.shortDescription}</p>
          </div>

          <div class="rs-card-footer">
            <a href={item.href} class="rs-detail-link">
              Explorar {item.name.toLowerCase()} →
            </a>
            <button
              type="button"
              class="rs-talk-btn"
              data-rs-talk
              data-prompt={item.starterPrompt}
              data-category={item.category}
            >
              Hablemos de esto
            </button>
          </div>
        </article>
      ))}
    </div>

    <div class="rs-all-links">
      <a href="/solutions/" class="btn btn-secondary btn-sm">Ver soluciones de desarrollo →</a>
      <a href="/marketing/" class="btn btn-secondary btn-sm">Ver marketing digital y marca →</a>
    </div>
  </div>
</section>

<style>
  .rs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-block-end: 1.75rem;
  }

  .rs-intro {
    max-inline-size: 640px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .rs-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .rs-indicator {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-secondary);
    font-variant-numeric: tabular-nums;
  }

  .rs-btn-group {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .rs-ctrl-btn {
    min-inline-size: 42px;
    min-block-size: 42px;
    padding-inline: 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(48, 27, 60, 0.16);
    background: var(--bg-surface);
    color: var(--ink-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .rs-ctrl-btn:hover {
    border-color: var(--accent-orange);
    color: var(--accent-deep);
  }

  .rs-pause-btn[aria-pressed="true"] {
    background: var(--bg-warm-tint);
    border-color: rgba(243, 75, 33, 0.35);
    color: var(--accent-deep);
  }

  /* Native horizontal scroll fallback when JS is unavailable */
  .rs-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2.3rem) / 3);
    gap: 1.15rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-block: 0.25rem 0.75rem;
    scrollbar-width: thin;
  }

  @media (prefers-reduced-motion: reduce) {
    .rs-track {
      scroll-behavior: auto;
    }
  }

  .rs-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
    padding: 1.4rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    min-block-size: 228px;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .rs-card:hover {
    border-color: rgba(243, 75, 33, 0.36);
  }

  .rs-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .rs-area-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.62rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .rs-area-badge.is-development {
    background: #f3edf5;
    color: var(--ink-primary);
  }

  .rs-area-badge.is-marketing {
    background: var(--bg-warm-tint);
    color: var(--accent-deep);
  }

  .rs-area-badge.is-brand {
    background: #edf6f1;
    color: #19593a;
  }

  .rs-card-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .rs-micro-visual {
    padding: 0.65rem 0.75rem;
    border-radius: 14px;
    background: linear-gradient(145deg, #faf6f3 0%, #f4edf6 100%);
    border: 1px solid rgba(48, 27, 60, 0.08);
  }

  .rs-vis-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .rs-vis-pill {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-surface);
    border: 1px solid rgba(48, 27, 60, 0.1);
    color: var(--ink-primary);
  }

  .rs-vis-pill.is-accent {
    background: var(--bg-warm-tint);
    border-color: rgba(243, 75, 33, 0.22);
    color: var(--accent-deep);
  }

  .rs-vis-pill.is-green {
    background: var(--status-confirmed-bg);
    border-color: rgba(25, 89, 58, 0.18);
    color: var(--status-confirmed-ink);
  }

  .rs-vis-arrow {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-orange);
  }

  .rs-vis-swatch {
    inline-size: 16px;
    block-size: 16px;
    border-radius: 50%;
    border: 1.5px solid #ffffff;
    box-shadow: 0 2px 6px rgba(48, 27, 60, 0.18);
  }

  .rs-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rs-card-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .rs-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-block-start: 0.8rem;
    border-top: 1px solid rgba(48, 27, 60, 0.07);
  }

  .rs-detail-link {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-deep);
  }

  .rs-detail-link:hover {
    text-decoration: underline;
  }

  .rs-talk-btn {
    border: 0;
    background: transparent;
    padding: 0.25rem 0.45rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-secondary);
    cursor: pointer;
  }

  .rs-talk-btn:hover {
    background: var(--bg-warm-tint);
    color: var(--accent-deep);
  }

  .rs-all-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.25rem;
  }

  @media (max-width: 980px) {
    .rs-track {
      grid-auto-columns: calc((100% - 1.15rem) / 2);
    }
  }

  @media (max-width: 640px) {
    .rs-track {
      grid-auto-columns: 100%;
    }
  }
</style>

<script>
  import { CHAT_ACTIVE_EVENT, requestAssistantOpen } from "@/lib/project/storage";

  const root = document.querySelector<HTMLElement>("[data-rotating-services]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-rs-track]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-rs-card]"));
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-rs-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-rs-next]");
    const toggleBtn = root.querySelector<HTMLButtonElement>("[data-rs-toggle]");
    const indicator = root.querySelector<HTMLElement>("[data-rs-indicator]");
    const talkBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-rs-talk]"));

    const total = cards.length;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let currentIndex = 0;
    let userPaused = prefersReducedMotion;
    let isVisible = false;
    let isHovered = false;
    let isFocused = false;
    let isChatActive = false;
    let timerId: number | null = null;

    function getVisibleCount(): number {
      if (window.innerWidth <= 640) return 1;
      if (window.innerWidth <= 980) return 2;
      return 3;
    }

    function updateIndicator() {
      if (!indicator) return;
      const visible = getVisibleCount();
      const start = currentIndex + 1;
      const end = Math.min(total, currentIndex + visible);
      indicator.textContent = visible === 1 ? `${start} de ${total}` : `${start}–${end} de ${total}`;
    }

    function updateToggleUi() {
      if (!toggleBtn) return;
      toggleBtn.setAttribute("aria-pressed", String(userPaused));
      toggleBtn.textContent = userPaused ? "Reanudar" : "Pausar";
      toggleBtn.setAttribute(
        "aria-label",
        userPaused ? "Reanudar rotación automática" : "Pausar rotación automática"
      );
    }

    function scrollToIndex(idx: number) {
      if (!track || !cards[idx]) return;
      currentIndex = idx;
      const cardEl = cards[idx];
      track.scrollTo({
        left: cardEl.offsetLeft - track.offsetLeft,
        behavior: prefersReducedMotion ? "auto" : "smooth"
      });
      updateIndicator();
    }

    function stepForward() {
      const visible = getVisibleCount();
      // Advance by visible window so all 13 services appear before repeating
      const next = currentIndex + visible >= total ? 0 : currentIndex + visible;
      scrollToIndex(next);
    }

    function stepBackward() {
      const visible = getVisibleCount();
      const prev =
        currentIndex === 0
          ? Math.max(0, total - visible)
          : Math.max(0, currentIndex - visible);
      scrollToIndex(prev);
    }

    function shouldAutoRotate(): boolean {
      return (
        !prefersReducedMotion &&
        !userPaused &&
        isVisible &&
        !isHovered &&
        !isFocused &&
        !isChatActive &&
        document.visibilityState === "visible"
      );
    }

    function syncTimer() {
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
      if (shouldAutoRotate()) {
        timerId = window.setInterval(() => {
          if (shouldAutoRotate()) {
            stepForward();
          }
        }, 8000);
      }
    }

    prevBtn?.addEventListener("click", () => {
      userPaused = true;
      updateToggleUi();
      stepBackward();
      syncTimer();
    });

    nextBtn?.addEventListener("click", () => {
      userPaused = true;
      updateToggleUi();
      stepForward();
      syncTimer();
    });

    toggleBtn?.addEventListener("click", () => {
      userPaused = !userPaused;
      updateToggleUi();
      syncTimer();
    });

    root.addEventListener("mouseenter", () => {
      isHovered = true;
      syncTimer();
    });
    root.addEventListener("mouseleave", () => {
      isHovered = false;
      syncTimer();
    });
    root.addEventListener("focusin", () => {
      isFocused = true;
      syncTimer();
    });
    root.addEventListener("focusout", () => {
      isFocused = false;
      syncTimer();
    });

    document.addEventListener("visibilitychange", syncTimer);
    window.addEventListener("resize", updateIndicator);

    window.addEventListener(CHAT_ACTIVE_EVENT, (ev: Event) => {
      const detail = (ev as CustomEvent<{ active: boolean }>).detail;
      isChatActive = Boolean(detail?.active);
      syncTimer();
    });

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          isVisible = Boolean(entries[0]?.isIntersecting);
          syncTimer();
        },
        { threshold: 0.25 }
      );
      io.observe(root);
    } else {
      isVisible = true;
    }

    talkBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const promptText = btn.dataset.prompt || "";
        const category = btn.dataset.category || null;
        requestAssistantOpen({
          promptText,
          category,
          source: "rotating-services"
        });
      });
    });

    updateIndicator();
    updateToggleUi();
    syncTimer();
  }
</script>
