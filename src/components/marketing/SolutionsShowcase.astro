---
import { solutions } from "@/content/solutions";
---

<section class="section solutions-section">
  <div class="container">
    <div class="section-intro">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Capacidades a medida</span>
      </div>
      <h2 class="heading-lg">Lo que tienes en mente puede tomar muchas formas</h2>
      <p class="lead">
        Desde una web comercial clara hasta sistemas operativos, portales y automatizaciones. Cada solución se diseña alrededor de cómo trabaja tu negocio.
      </p>
    </div>

    <div class="solutions-bento">
      {solutions.map((item, idx) => (
        <article class:list={["solution-card", { "is-wide": idx === 0 || idx === 3, "is-half": idx === 4 || idx === 5 }]}>
          <div class="solution-card-visual" aria-hidden="true">
            {item.previewType === "web" && (
              <div class="mini-ui mini-ui-web">
                <div class="mini-bar">
                  <span class="mini-dot"></span><span class="mini-dot"></span><span class="mini-dot"></span>
                  <span class="mini-url">tunegocio.cl</span>
                </div>
                <div class="mini-web-hero">
                  <div class="mini-pill-tag">Propuesta clara</div>
                  <div class="mini-h-bar"></div>
                  <div class="mini-p-bar"></div>
                  <div class="mini-cta-chip">Agendar evaluación →</div>
                </div>
              </div>
            )}

            {item.previewType === "app" && (
              <div class="mini-ui mini-ui-app">
                <div class="mini-app-row">
                  <span class="mini-app-badge">Hoy · 11:30</span>
                  <span class="mini-app-state">Confirmada</span>
                </div>
                <div class="mini-app-title">Servicio agendado</div>
                <div class="mini-app-steps">
                  <span class="step-on">1. Elegir</span>
                  <span class="step-on">2. Hora</span>
                  <span class="step-on">3. Listo</span>
                </div>
              </div>
            )}

            {item.previewType === "system" && (
              <div class="mini-ui mini-ui-system">
                <div class="mini-sys-row">
                  <span>#4821 · Norte</span>
                  <span class="sys-tag orange">En bodega</span>
                </div>
                <div class="mini-sys-row">
                  <span>#4822 · Sur</span>
                  <span class="sys-tag green">Despachado</span>
                </div>
                <div class="mini-sys-row">
                  <span>#4823 · Centro</span>
                  <span class="sys-tag plum">Recibido</span>
                </div>
              </div>
            )}

            {item.previewType === "portal" && (
              <div class="mini-ui mini-ui-portal">
                <div class="mini-portal-col">
                  <span class="mini-portal-k">Clientes</span>
                  <span class="mini-portal-v">12 solicitudes activas</span>
                </div>
                <div class="mini-portal-col">
                  <span class="mini-portal-k">Documentos</span>
                  <span class="mini-portal-v">Fichas y facturas al día</span>
                </div>
              </div>
            )}

            {item.previewType === "automation" && (
              <div class="mini-ui mini-ui-auto">
                <span class="auto-node">Formulario</span>
                <span class="auto-arrow">→</span>
                <span class="auto-node is-accent">Regla</span>
                <span class="auto-arrow">→</span>
                <span class="auto-node">CRM + Aviso</span>
              </div>
            )}

            {item.previewType === "ai" && (
              <div class="mini-ui mini-ui-ai">
                <div class="ai-q">«¿Qué repuesto aplica al modelo X-20?»</div>
                <div class="ai-a">
                  <strong>Fuente verificada:</strong> Manual técnico pág. 14 · Revisión humana activa.
                </div>
              </div>
            )}
          </div>

          <div class="solution-card-body">
            <h3 class="heading-md">{item.name}</h3>
            <p class="solution-card-desc">{item.shortDescription}</p>
            <div class="solution-card-actions">
              <a href={`/solutions/${item.slug}/`} class="solution-link">
                Explorar {item.name.toLowerCase()} →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-intro {
    max-inline-size: 680px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-block-end: clamp(2.25rem, 4.5vw, 3.25rem);
  }

  .solutions-bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .solution-card {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .solution-card.is-wide {
    grid-column: span 8;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
  }

  .solution-card.is-half {
    grid-column: span 6;
  }

  .solution-card:hover {
    border-color: rgba(243, 75, 33, 0.34);
  }

  @media (prefers-reduced-motion: no-preference) {
    .solution-card:hover {
      transform: translateY(-2px);
    }
  }

  .solution-card-visual {
    border-radius: var(--radius-md);
    background: linear-gradient(155deg, #faf6f3 0%, #f4edf5 100%);
    border: 1px solid rgba(48, 27, 60, 0.08);
    padding: 1rem;
    min-block-size: 148px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mini-ui {
    inline-size: 100%;
    border-radius: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.8rem;
    font-size: 0.76rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mini-bar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding-block-end: 0.4rem;
    border-bottom: 1px solid rgba(48, 27, 60, 0.08);
  }

  .mini-dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: rgba(48, 27, 60, 0.2);
  }

  .mini-url {
    margin-inline-start: 0.4rem;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .mini-web-hero {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .mini-pill-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent-deep);
    background: var(--bg-warm-tint);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .mini-h-bar {
    inline-size: 82%;
    block-size: 10px;
    border-radius: 4px;
    background: var(--ink-primary);
  }

  .mini-p-bar {
    inline-size: 62%;
    block-size: 7px;
    border-radius: 4px;
    background: rgba(48, 27, 60, 0.22);
  }

  .mini-cta-chip {
    margin-block-start: 0.2rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--ink-primary);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .mini-app-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
  }

  .mini-app-badge {
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .mini-app-state {
    color: var(--status-confirmed-ink);
    background: var(--status-confirmed-bg);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-weight: 700;
  }

  .mini-app-title {
    font-weight: 700;
    font-size: 0.85rem;
  }

  .mini-app-steps {
    display: flex;
    gap: 0.35rem;
  }

  .step-on {
    flex: 1;
    text-align: center;
    padding: 0.2rem;
    border-radius: 6px;
    background: var(--bg-warm-tint);
    color: var(--accent-deep);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .mini-sys-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.2rem;
    border-bottom: 1px solid rgba(48, 27, 60, 0.06);
    font-weight: 600;
  }

  .mini-sys-row:last-child {
    border-bottom: 0;
  }

  .sys-tag {
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .sys-tag.orange {
    background: var(--status-suggested-bg);
    color: var(--status-suggested-ink);
  }

  .sys-tag.green {
    background: var(--status-confirmed-bg);
    color: var(--status-confirmed-ink);
  }

  .sys-tag.plum {
    background: var(--status-pending-bg);
    color: var(--status-pending-ink);
  }

  .mini-ui-portal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mini-portal-col {
    padding: 0.6rem;
    border-radius: 10px;
    background: var(--bg-canvas);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mini-portal-k {
    font-size: 0.72rem;
    color: var(--ink-primary);
    font-weight: 700;
  }

  .mini-portal-v {
    font-size: 0.76rem;
    font-weight: 700;
  }

  .mini-ui-auto {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .auto-node {
    padding: 0.42rem 0.55rem;
    border-radius: 9px;
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    font-size: 0.7rem;
    font-weight: 700;
    text-align: center;
  }

  .auto-node.is-accent {
    background: var(--bg-warm-tint);
    border-color: rgba(243, 75, 33, 0.35);
    color: var(--accent-deep);
  }

  .auto-arrow {
    color: var(--accent-orange);
    font-weight: 800;
  }

  .ai-q {
    font-weight: 700;
    color: var(--ink-primary);
  }

  .ai-a {
    padding: 0.5rem 0.65rem;
    border-radius: 9px;
    background: var(--status-confirmed-bg);
    color: var(--status-confirmed-ink);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .solution-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .solution-card-desc {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .solution-card-actions {
    margin-block-start: 0.35rem;
  }

  .solution-link {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-deep);
  }

  .solution-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .solution-card,
    .solution-card.is-wide {
      grid-column: span 6;
      display: flex;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .solution-card,
    .solution-card.is-wide {
      grid-column: span 12;
    }
  }
</style>
