---
import { heroExampleChips, siteConfig } from "@/content/site";
---

<section class="hero-section">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="hero-glow hero-glow-primary"></div>
    <div class="hero-glow hero-glow-secondary"></div>
    <div class="hero-grain"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-header fade-up">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>{siteConfig.tagline}</span>
      </div>

      <h1 class="hero-title">
        <span class="hero-title-line-1">Tu idea merece existir.</span>
        <span class="hero-title-line-2">Hagámosla realidad.</span>
      </h1>

      <p class="hero-lead">
        Diseño, desarrollo y marketing digital para crear, lanzar y hacer crecer tu negocio.
      </p>
    </div>

    <div class="composer-wrap fade-up" data-hero-composer>
      <div class="draft-banner" hidden data-draft-banner>
        <span class="draft-banner-text">Tienes un borrador de proyecto guardado en este navegador.</span>
        <a href="/create-project/" class="draft-banner-link">Continuar borrador →</a>
      </div>

      <form class="composer-card" data-idea-form novalidate>
        <label for="hero-idea-input" class="visually-hidden">
          Describe tu idea de proyecto digital
        </label>

        <textarea
          id="hero-idea-input"
          name="idea"
          rows="3"
          maxlength="1200"
          class="composer-textarea"
          placeholder="Quiero crear una plataforma para que mis clientes puedan…"
          aria-describedby="hero-idea-hint hero-idea-error"
        ></textarea>

        <div id="hero-idea-error" class="composer-error" role="alert" hidden></div>

        <div class="composer-replace-bar" hidden data-replace-bar>
          <span class="composer-replace-msg">Ya escribiste tu propia idea. ¿Quieres reemplazarla con este ejemplo?</span>
          <div class="composer-replace-actions">
            <button type="button" class="btn btn-primary btn-sm" data-confirm-replace>Reemplazar</button>
            <button type="button" class="btn btn-secondary btn-sm" data-cancel-replace>Conservar mi texto</button>
          </div>
        </div>

        <div class="composer-footer">
          <p id="hero-idea-hint" class="composer-micro">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
              <path d="M5.5 8.2l1.7 1.7 3.3-3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Empieza sin registrarte.</span>
          </p>

          <button type="submit" class="btn btn-primary composer-submit">
            <span>Definir mi proyecto</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8h9m0 0L9 4.5M12.5 8L9 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </form>

      <div class="composer-examples" role="group" aria-label="Ejemplos rápidos para empezar">
        <span class="composer-examples-label">Ejemplos:</span>
        <div class="composer-chips">
          {heroExampleChips.map((chip) => (
            <button
              type="button"
              class="example-chip"
              data-example-chip
              data-example-prompt={chip.prompt}
              data-example-category={chip.category}
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <p class="hero-responsibility">
        {siteConfig.responsibilityStatement}
      </p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-block: clamp(2.25rem, 5vw, 4.25rem) clamp(4.5rem, 8vw, 6.75rem);
    overflow: clip;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
  }

  .hero-glow-primary {
    inset-inline-start: 50%;
    inset-block-start: 56%;
    transform: translate(-50%, -42%);
    inline-size: min(1080px, 118vw);
    block-size: clamp(320px, 42vw, 520px);
    background: radial-gradient(
      ellipse at center,
      rgba(243, 75, 33, 0.36) 0%,
      rgba(255, 138, 92, 0.32) 34%,
      rgba(255, 209, 180, 0.42) 62%,
      rgba(250, 248, 246, 0) 80%
    );
  }

  .hero-glow-secondary {
    inset-inline-end: -10%;
    inset-block-start: 18%;
    inline-size: 460px;
    block-size: 460px;
    background: radial-gradient(
      circle,
      rgba(255, 209, 180, 0.45) 0%,
      rgba(243, 237, 243, 0.25) 50%,
      rgba(250, 248, 246, 0) 75%
    );
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    background-image: radial-gradient(rgba(48, 27, 60, 0.8) 0.5px, transparent 0.5px);
    background-size: 14px 14px;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-inline-size: 980px;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-size: var(--text-hero);
    line-height: 1.03;
    letter-spacing: -0.038em;
    font-weight: 800;
    text-wrap: balance;
  }

  .hero-title-line-1 {
    color: var(--ink-primary);
  }

  .hero-title-line-2 {
    background: linear-gradient(96deg, #b92f0e 0%, #f34b21 52%, #d43812 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-block-end: 0.06em;
  }

  .hero-lead {
    max-inline-size: 620px;
    font-size: clamp(1.0625rem, 1.55vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .composer-wrap {
    inline-size: 100%;
    max-inline-size: 840px;
    margin-block-start: clamp(1.75rem, 3.6vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .draft-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(48, 27, 60, 0.14);
    font-size: var(--text-xs);
    text-align: start;
  }

  .draft-banner-text {
    color: var(--ink-secondary);
  }

  .draft-banner-link {
    font-weight: 700;
    color: var(--accent-deep);
  }

  .draft-banner-link:hover {
    text-decoration: underline;
  }

  .composer-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1rem, 2.2vw, 1.45rem);
    border-radius: 26px;
    background: var(--bg-surface);
    border: 1px solid rgba(48, 27, 60, 0.14);
    box-shadow: var(--shadow-composer);
    text-align: start;
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .composer-card:focus-within {
    border-color: rgba(243, 75, 33, 0.48);
    box-shadow:
      0 26px 68px -20px rgba(243, 75, 33, 0.28),
      0 0 0 4px rgba(243, 75, 33, 0.1);
  }

  .composer-textarea {
    inline-size: 100%;
    min-block-size: 98px;
    resize: vertical;
    border: 0;
    background: transparent;
    padding: 0.25rem 0.35rem;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.55;
    color: var(--ink-primary);
  }

  .composer-textarea::placeholder {
    color: #84788c;
  }

  .composer-textarea:focus-visible {
    outline: none;
  }

  .composer-error {
    padding: 0.55rem 0.85rem;
    border-radius: 12px;
    background: var(--status-suggested-bg);
    color: var(--accent-deep);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .composer-replace-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    background: var(--bg-warm-tint);
    border: 1px solid rgba(243, 75, 33, 0.24);
  }

  .composer-replace-msg {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .composer-replace-actions {
    display: flex;
    gap: 0.5rem;
  }

  .composer-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding-block-start: 0.65rem;
    border-top: 1px solid rgba(48, 27, 60, 0.08);
  }

  .composer-micro {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .composer-micro svg {
    color: var(--accent-deep);
  }

  .composer-submit {
    min-block-size: 48px;
    padding-inline: 1.55rem;
    font-size: var(--text-sm);
  }

  .composer-examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-block-start: 0.25rem;
  }

  .composer-examples-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .composer-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
  }

  .example-chip {
    min-block-size: 38px;
    padding: 0.42rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(48, 27, 60, 0.14);
    background: rgba(255, 255, 255, 0.88);
    color: var(--ink-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .example-chip:hover {
    background: var(--bg-surface);
    border-color: rgba(243, 75, 33, 0.42);
    color: var(--accent-deep);
  }

  .hero-responsibility {
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    margin-block-start: 0.25rem;
  }

  @media (max-width: 600px) {
    .composer-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .composer-submit {
      inline-size: 100%;
    }

    .composer-micro {
      justify-content: center;
    }
  }
</style>

<script>
  import { hasSavedDraft, saveStarterIdea } from "@/lib/project/storage";

  const root = document.querySelector("[data-hero-composer]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-idea-form]");
    const textarea = root.querySelector<HTMLTextAreaElement>("#hero-idea-input");
    const errorEl = root.querySelector<HTMLElement>("#hero-idea-error");
    const replaceBar = root.querySelector<HTMLElement>("[data-replace-bar]");
    const confirmReplaceBtn = root.querySelector<HTMLButtonElement>("[data-confirm-replace]");
    const cancelReplaceBtn = root.querySelector<HTMLButtonElement>("[data-cancel-replace]");
    const draftBanner = root.querySelector<HTMLElement>("[data-draft-banner]");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-example-chip]"));

    let selectedCategory: string | null = null;
    let lastAppliedChipPrompt = "";
    let pendingChip: { prompt: string; category: string | null } | null = null;

    if (draftBanner && hasSavedDraft()) {
      draftBanner.hidden = false;
    }

    const showError = (msg: string) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
      textarea?.setAttribute("aria-invalid", msg ? "true" : "false");
    };

    const applyChip = (prompt: string, category: string | null) => {
      if (!textarea) return;
      textarea.value = prompt;
      lastAppliedChipPrompt = prompt;
      selectedCategory = category;
      if (replaceBar) replaceBar.hidden = true;
      pendingChip = null;
      showError("");
      textarea.focus();
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (!textarea) return;
        const prompt = chip.dataset.examplePrompt || "";
        const category = chip.dataset.exampleCategory || null;
        const current = textarea.value.trim();

        // Protect user-written text from accidental overwrite (spec §5)
        if (current && current !== lastAppliedChipPrompt.trim()) {
          pendingChip = { prompt, category };
          if (replaceBar) replaceBar.hidden = false;
          confirmReplaceBtn?.focus();
          return;
        }
        applyChip(prompt, category);
      });
    });

    confirmReplaceBtn?.addEventListener("click", () => {
      if (pendingChip) applyChip(pendingChip.prompt, pendingChip.category);
    });

    cancelReplaceBtn?.addEventListener("click", () => {
      pendingChip = null;
      if (replaceBar) replaceBar.hidden = true;
      textarea?.focus();
    });

    textarea?.addEventListener("input", () => {
      if (errorEl && !errorEl.hidden) showError("");
    });

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const idea = textarea?.value.trim() || "";
      if (idea.length < 6) {
        showError("Cuéntanos en una frase qué te gustaría construir o elige uno de los ejemplos de abajo.");
        textarea?.focus();
        return;
      }
      saveStarterIdea(idea, selectedCategory);
      window.location.href = "/create-project/";
    });
  }
</script>
