---
import { site } from "@/data/site";

const year = Math.max(new Date().getFullYear(), 2026);

const primaryLinks = [
  { label: "Work & Casos", href: "/casos/" },
  { label: "Capacidades & Alcance", href: "/servicios/" },
  { label: "Studio & Manifiesto", href: "/nosotros/" },
  { label: "Insights & Perspectivas", href: "/blog/" },
  { label: "Start a Project", href: "/contacto/" },
];

const capabilitiesLinks = [
  { label: "Consultoría Estratégica & Negocio", href: "/servicios/" },
  { label: "Dirección de Arte & Identidad", href: "/servicios/" },
  { label: "Plataformas Web & Software a Medida", href: "/servicios/" },
  { label: "Diseño Industrial & Hardware (NOVVOR)", href: "/servicios/" },
];
---

<footer class="bg-[#050505] text-[#F7F7F4] border-t border-white/10 pt-20 pb-12 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-white/10">
      {/* Brand Column */}
      <div class="lg:col-span-6 space-y-6">
        <a href="/" class="inline-flex items-center gap-3" aria-label="ENIX STUDIO">
          <img
            class="h-8 w-auto object-contain brightness-0 invert"
            src="/brand/enix-logo.png"
            alt="ENIX STUDIO"
            width="1578"
            height="447"
            loading="lazy"
            decoding="async"
          />
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400 border-l border-white/15 pl-3">
            Studio
          </span>
        </a>

        <p class="max-w-md text-sm text-neutral-400 leading-relaxed font-light">
          Consultoría estratégica, dirección de arte e ingeniería aplicada para empresas que compiten en ligas mayores. Operaciones globales y atención directiva remota para LATAM, Norteamérica y Europa.
        </p>

        <div class="pt-2 font-mono text-xs text-neutral-400 space-y-1">
          <p>Worldwide Operations · Global Practice · Est. 2017</p>
          <p>
            Consultas directas: <a href={`mailto:${site.email}`} class="text-white hover:underline">{site.email}</a>
          </p>
        </div>
      </div>

      {/* Navigation Columns */}
      <div class="lg:col-span-3 space-y-4">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Navegación
        </span>
        <ul class="space-y-3">
          {primaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-300 hover:text-white transition flex items-center gap-1 group"
              >
                <span>{link.label}</span>
                <span class="font-mono text-xs text-neutral-500 opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3 space-y-4">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400 block">
          Capacidades Directivas
        </span>
        <ul class="space-y-3">
          {capabilitiesLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-400 hover:text-neutral-200 transition">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom Legal Strip */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-neutral-400">
      <div>
        © {year} ENIX STUDIO. Powered by NOVVOR. All rights reserved.
      </div>

      <div class="flex items-center gap-6">
        <a href="/politica-de-privacidad/" class="hover:text-white transition">
          Privacidad
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
          LinkedIn
        </a>
        <a href="/contacto/" class="text-white hover:underline">
          Start a Project ↗
        </a>
      </div>
    </div>
  </div>
</footer>
